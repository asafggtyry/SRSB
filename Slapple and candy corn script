local function makeFarmCard(x, title, key, desc)
    local card = frame(pages.Farms, x, 90, 280, 190, Color3.fromRGB(62,62,58), .55, 24); stroke(card, .9)

    text(card, title, 20, 20, 240, 30, 18, C.text, Enum.Font.GothamMedium)
    text(card, desc,  20, 55, 240, 20, 12, C.muted)

    local statusBig = text(card, "OFF", 20, 90, 240, 50, 34, C.muted)
    local bar  = frame(card, 20, 158, 240, 6, C.text, .8, 3)
    local fill = frame(bar, 0, 0, 0, 6, C.purple, 0, 3); fill.Size = UDim2.fromScale(0, 1)

    local click = Instance.new("TextButton")
    click.Size = UDim2.fromScale(1, 1)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = card

    local function refreshCard()
        if States[key] then
            statusBig.Text = "ON"; statusBig.TextColor3 = ink
            card.BackgroundColor3 = C.purple; card.BackgroundTransparency = .1
            fill.Size = UDim2.fromScale(1, 1)
        else
            statusBig.Text = "OFF"; statusBig.TextColor3 = C.muted
            card.BackgroundColor3 = Color3.fromRGB(62,62,58); card.BackgroundTransparency = .55
            fill.Size = UDim2.fromScale(0, 1)
        end
    end

    click.MouseButton1Click:Connect(function()
        States[key] = not States[key]
        refreshCard()
        if States.FarmCandy and States.FarmSlapple then
            farmStatus.Text = "Both farms running"
        elseif States.FarmCandy then
            farmStatus.Text = "Candy Corn farm running"
        elseif States.FarmSlapple then
            farmStatus.Text = "Slapple farm running"
        else
            farmStatus.Text = "Both farms off"
        end
    end)
    refreshCard()
    farmButtons[key] = refreshCard
end

