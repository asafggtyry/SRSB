-- DRAG
-- ==========================================
local drag, ds, sp, dragInput
local function onWindow(point)
    local over = false
    for _, obj in ipairs(PlayerGui:GetGuiObjectsAtPosition(point.X, point.Y)) do
        if obj:IsDescendantOf(mf) then
            over = true
            local node = obj
            while node and node ~= mf do
                if node:IsA("GuiButton") or node:IsA("TextBox") or node:IsA("ScrollingFrame") then return false end
                node = node.Parent
            end
        end
    end
    return over
end
UserInputService.InputBegan:Connect(function(input)
    if drag or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then return end
    if not sg.Parent or not onWindow(input.Position) then return end
    drag = true; ds = input.Position; sp = mf.Position; dragInput = input
end)
UserInputService.InputChanged:Connect(function(input)
    if not drag then return end
    if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local d = input.Position - ds
    mf.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
end)
UserInputService.InputEnded:Connect(function(input)
    if input == dragInput then drag = false; dragInput = nil end
end)

