local States = { FarmCandy = false, FarmSlapple = false }

-- === Farm config ===
local CANDY_FOLDER_NAME  = "CandyCorns"
local ARENA_NAME         = "Arena"
local ISLAND_NAME        = "island5"
local SLAPPLE_FOLDER_NAME= "Slapples"
local GLOVE_NAME         = "Glove"
local FARM_INTERVAL      = 0.25

local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end
local function findSlappleFolder()
    local arena = workspace:FindFirstChild(ARENA_NAME)
    if not arena then return nil end
    local island = arena:FindFirstChild(ISLAND_NAME)
    if not island then return nil end
    return island:FindFirstChild(SLAPPLE_FOLDER_NAME)
end
local function findAllPartsByName(container, name)
    local results = {}
    if not container then return results end
    local function search(inst)
        for _, child in ipairs(inst:GetChildren()) do
            if child:IsA("BasePart") and child.Name == name then
                table.insert(results, child)
            end
            if child:IsA("Folder") or child:IsA("Model") then
                search(child)
            end
        end
    end
    pcall(search, container)
    return results
end

-- === Farm loop ===
task.spawn(function()
    while true do
        if not (States.FarmCandy or States.FarmSlapple) then
            task.wait(0.1)
        else
            local hrp = getHRP()
            if hrp then
                if States.FarmCandy then
                    local candyFolder = workspace:FindFirstChild(CANDY_FOLDER_NAME)
                    if candyFolder then
                        for _, candy in pairs(candyFolder:GetChildren()) do
                            if candy.Parent and candy:IsA("BasePart") then
                                pcall(function() candy.CFrame = hrp.CFrame end)
                            end
                        end
                    end
                end
                if States.FarmSlapple then
                    local sf = findSlappleFolder()
                    if sf then
                        for _, glove in ipairs(findAllPartsByName(sf, GLOVE_NAME)) do
                            if glove.Parent then
                                pcall(function() glove.CFrame = hrp.CFrame end)
                            end
                        end
                    end
                end
            end
            task.wait(FARM_INTERVAL)
        end
    end
end)

