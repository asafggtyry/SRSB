-- ============ FIRST-PERSON WATCHDOG ============
-- Suction obby loves to flip you to LockFirstPerson. If unlocked, we re-assert
-- Default behavior on a slow poll too (belt & suspenders on top of RenderStepped).
task.spawn(function()
    while screenGui.Parent do
        task.wait(1)
        if cursorUnlocked then
            local ok, isFirstPerson = pcall(function()
                return LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson
            end)
            if ok and isFirstPerson then
                refreshCursorStatus()
            end
        end
    end
end)

