    b.TextColor3       = COLORS.text
    b.TextSize         = 12
    b.Font             = Enum.Font.GothamSemibold
    b.BorderSizePixel  = 0
    b.Parent           = innerPanel
    addCorner(b, 6)
    addStroke(b, 0.4)
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = COLORS.buttonHover
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = color or COLORS.button
    end)
    b.MouseButton1Click:Connect(onClick)
    return b
end

-- ============ ACTIONS ============
local function tpToObby()
    local cur = ReplicatedStorage
    for _, n in ipairs(REMOTE_PATH) do
        cur = cur and cur:FindFirstChild(n)
        if not cur then
            setStatus("❌ Remote path missing: " .. table.concat(REMOTE_PATH, "."), COLORS.red)
            return
        end
    end
    local remote = cur
    if not remote:IsA("RemoteEvent") and not remote:IsA("RemoteFunction") then
        setStatus("❌ Remote is wrong type", COLORS.red)
        return
    end

    -- Auto-unlock cursor BEFORE firing — this is where the obby
    -- forces first-person and locks the mouse.
    unlockCursor()
    refreshCursorUI()

    pcall(function() remote:FireServer() end)
    setStatus("✅ Fired suction_obby_tp (cursor unlocked)", COLORS.green)
end

-- Glove pinning
local pinned    = false
local pinConn   = nil
local bringBtn  -- forward-declared so callback can change its label

local function findPlungerPart()
    local folder = workspace:FindFirstChild(GLOVE_FOLDER)
    local part   = folder and folder:FindFirstChild(GLOVE_PART)
    return part
end

local function releaseGlove()
    if pinConn then pinConn:Disconnect(); pinConn = nil end
    pinned = false
    if bringBtn then
        bringBtn.Text             = "Bring Glove To Me"
        bringBtn.BackgroundColor3 = COLORS.green
    end
    setStatus("Released", COLORS.muted)
end

local function pinGlove()
    local target = findPlungerPart()
    if not target then
        setStatus("❌ " .. GLOVE_PART .. " not found", COLORS.red)
        return
    end
    if not target:IsA("BasePart") then
        setStatus("❌ Target is not a BasePart", COLORS.red)
        return
    end

    local cam = workspace.CurrentCamera
    pinConn = RunService.RenderStepped:Connect(function()
        target.CFrame = cam.CFrame * CFrame.new(0, 0, -5)
    end)
    pinned = true
    if bringBtn then
        bringBtn.Text             = "Release Glove"
        bringBtn.BackgroundColor3 = COLORS.danger
    end
    setStatus("🪠 Glove pinned to camera", COLORS.green)
end

