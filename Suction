-- ============ HELPERS ============
local function addCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function addStroke(parent, transparency)
    local s = Instance.new("UIStroke")
    s.Color        = COLORS.border
    s.Thickness    = 1
    s.Transparency = transparency or 0
    s.Parent       = parent
    return s
end

local function ownsGlove(name)
    local folder = LocalPlayer:FindFirstChild("_unlockedGloves")
    if not folder then return nil end
    local bv = folder:FindFirstChild(name)
    if bv and bv:IsA("BoolValue") then return bv.Value end
    return nil
end

-- ============ CURSOR UNLOCKER ============
-- The suction obby forces first-person and slams the mouse lock on.
-- We keep re-applying Default every frame while unlocked so it can't re-lock.
local cursorUnlocked   = false
local cursorUnlockLoop = nil

local function unlockCursor()
    if cursorUnlocked then return end
    cursorUnlocked   = true
    cursorUnlockLoop = RunService.RenderStepped:Connect(function()
        UserInputService.MouseBehavior    = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
end

local function lockCursor()
    if not cursorUnlocked then return end
    cursorUnlocked = false
    if cursorUnlockLoop then
        cursorUnlockLoop:Disconnect()
        cursorUnlockLoop = nil
    end
end

-- Forward-declared so toggle can refresh UI
local refreshCursorUI

local function toggleCursorUnlock()
    if cursorUnlocked then lockCursor() else unlockCursor() end
    if refreshCursorUI then refreshCursorUI() end
end

