local function getBagCount()
    local hud = PlayerGui:FindFirstChild("HUD")
    local candyBag = hud and hud:FindFirstChild("CandyBag")
    local label = candyBag and candyBag:FindFirstChild("TextLabel")
    if label and (label:IsA("TextLabel") or label:IsA("TextButton")) then
        local n = tonumber(label.Text:gsub(",", ""):match("%d+"))
        if n then AutoSeq.bagReadable=true; return n end
