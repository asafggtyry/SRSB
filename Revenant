    local char = LocalPlayer.Character
    if char then
        local a = char:GetAttribute("CollectedCandy")
        if tonumber(a) then AutoSeq.bagReadable=true; return tonumber(a) end
    end
    AutoSeq.bagReadable=false
    return 0
end

