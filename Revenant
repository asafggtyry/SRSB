-- Read the interaction offered by the shared prompt before choosing or firing an action.
function Helpers.dropMode(prompt)
    if not prompt or not prompt.Parent then return "missing" end
    local text=(prompt.ActionText or ""):lower()
    if text:find("deposit",1,true) or text:find("donate",1,true) then return "deposit" end
    if text:find("vote",1,true) or text:find("start",1,true) or text:find("begin",1,true) then return "vote" end
    if text:find("defend",1,true) or text:find("wave in progress",1,true) or text:find("wave active",1,true) then return "combat" end
    return "unknown"
end
function Helpers.candyForDrop(prompt)
