function Helpers.standSpot(raw,char,hrp,hum,minions,ignoreEnemies,relaxed,ground)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char}
    params.IgnoreWater=false
    params.RespectCanCollide=true
    local origin=ground and Vector3.new(raw.X,ground.originY,raw.Z) or raw+Vector3.new(0,5,0)
    local depth=ground and 40 or 12
    local hit
    for _=1,(ground and 3 or 1) do
        hit=workspace:Raycast(origin,Vector3.new(0,-depth,0),params)
        if not hit then break end
        if not ground or hit.Position.Y<=ground.maxFloorY then break end
        -- A roof/awning above the door's floor estimate is not a landing surface.
        params.FilterDescendantsInstances={char,hit.Instance,table.unpack(ground.skipped or {})}
        ground.skipped=ground.skipped or {}; ground.skipped[#ground.skipped+1]=hit.Instance
        local traveled=(origin-hit.Position).Magnitude+.05
        depth=depth-traveled; origin=hit.Position-Vector3.new(0,.05,0)
        if depth<=0 then hit=nil; break end
        hit=nil
    end
    if ground then ground.skipped=nil end
    if not hit then return Helpers.rejectHouse("raycast miss") end
    if hit.Normal.Y<.65 then return Helpers.rejectHouse("steep surface") end
    if hit.Material==Enum.Material.Water then return Helpers.rejectHouse("water") end
    if not hit.Instance.CanCollide then return Helpers.rejectHouse("floor not solid") end
    if Helpers.hazardMarked(hit.Instance) then return Helpers.rejectHouse("explicit hazard") end
    local lift=math.max(2.5,hum.HipHeight+hrp.Size.Y*.5)
    local point=hit.Position+Vector3.new(0,lift+.15,0)
    if not ignoreEnemies and Helpers.enemiesNear(point,30,minions) then return Helpers.rejectHouse("enemies near retreat") end
    local overlap=OverlapParams.new()
    overlap.FilterType=Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances={char}
    local size=Vector3.new(math.max(1.2,hrp.Size.X*.6),math.max(2,hrp.Size.Y),math.max(1.2,hrp.Size.Z*.6))
    for _,part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(point),size,overlap)) do
        if Helpers.hazardMarked(part) then return Helpers.rejectHouse("explicit hazard") end
        -- Merely overlapping a post, awning or trim does not reject a doorway.
        -- In strict mode, only the root center being inside a solid block is rejected.
        if not relaxed and part~=hit.Instance and part.CanCollide
            and part:IsA("Part") and part.Shape==Enum.PartType.Block then
            local localPoint=part.CFrame:PointToObjectSpace(point)
            local half=part.Size*.5
            if math.abs(localPoint.X)<half.X-.1 and math.abs(localPoint.Y)<half.Y-.1
                and math.abs(localPoint.Z)<half.Z-.1 then return Helpers.rejectHouse("root inside solid block") end
        end
    end
    return point,nil,hit.Instance
end
