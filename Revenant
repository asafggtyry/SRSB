-- ==================== MAIN LOOP ====================
local function runMainTick()
    if not mf.Parent or Safety.paused then return end

    local char,hrp,hum = getChar()
    if not char or not hrp or not hum or hum.Health<=0 then return end

    if hrp.Position.Y < -100 then
        local _,c = findCornifer()
        if c then char:PivotTo(CFrame.new(c.Position + Vector3.new(0, 6, 0))) end
        return
    end

    if S.AutoComplete then
        if tick()-lastAuto < Settings.LoopDelay then return end
        lastAuto = tick()
        activeAutoToken=AutoSeq.generation
        runAutoSequence()
        return
    end

    if tick()-lastCombat < COMBAT_INTERVAL then return end
    lastCombat = tick()

    if not (S.AutoFarm or S.AutoDefend or S.AutoSlap) and releaseCombatHold then releaseCombatHold() end
    if S.AutoDeposit and shouldDeposit() then
        depositBag(); return
    end
    if S.AutoFarmHouses then farmOneHouse() end

    if S.AutoFarm or S.AutoDefend or S.AutoSlap then
        local char2,hrp2,hum2 = getChar()
        if not char2 or not hrp2 or not hum2 then return end
        local _, corniPart = findCornifer()
        local minions = getMinions()
        if #minions == 0 then
            releaseCombatHold()
            if (S.AutoDefend or S.AutoFarm) and corniPart then
                moveOnce(corniPart,CFrame.new(corniPart.Position + Vector3.new(0, 5, 0)),5)
            end
            return
        end
        local target, best = nil, math.huge
        for _, m in ipairs(minions) do
            if S.AutoDefend and corniPart then
                local d = (m.pos - corniPart.Position).Magnitude
                if d <= 60 and d < best then best = d; target = m end
            else
                local d = (m.pos - hrp2.Position).Magnitude
                if d < best then best = d; target = m end
            end
        end
        if not target and S.AutoFarm then
            for _, m in ipairs(minions) do
                local d = (m.pos - hrp2.Position).Magnitude
                if d < best then best = d; target = m end
            end
        end
        if target then slapTarget(target) end
    end
end

task.spawn(function()
    while sg.Parent do
        activeAutoToken=nil
        local ok,err=pcall(runMainTick)
        activeAutoToken=nil
        if not ok then
            setStatus("waiting: retrying current action")
            warn("[Revant Farmer] "..tostring(err))
        end
        task.wait(Settings.LoopDelay)
    end
end)

