-- Multi-strategy TextLabel.Text getter. Handles:
--   • SurfaceGui as a direct child (name = "SurfaceGui" or any)
--   • SurfaceGui nested anywhere under the counter
--   • SurfaceGui Adornee-linked from PlayerGui / StarterGui
--   • Fallback: any TextLabel descendant
function Helpers.findSurfaceTextLabel(container)
    if not container then return nil end

    -- 1) Direct SurfaceGui child
    local sGui = container:FindFirstChildOfClass("SurfaceGui")
    if sGui then
        local lbl = sGui:FindFirstChildOfClass("TextLabel")
            or sGui:FindFirstChildWhichIsA("TextLabel", true)
        if lbl then return lbl end
    end

    -- 2) Child literally named "SurfaceGui" / "Surface"
    local named = container:FindFirstChild("SurfaceGui") or container:FindFirstChild("Surface")
    if named and named:IsA("SurfaceGui") then
        local lbl = named:FindFirstChildOfClass("TextLabel")
            or named:FindFirstChildWhichIsA("TextLabel", true)
        if lbl then return lbl end
    end

    -- 3) Any SurfaceGui descendant
    local sGui2 = container:FindFirstChildWhichIsA("SurfaceGui", true)
    if sGui2 then
        local lbl = sGui2:FindFirstChildOfClass("TextLabel")
            or sGui2:FindFirstChildWhichIsA("TextLabel", true)
        if lbl then return lbl end
    end

    -- 4) Any TextLabel descendant (last resort)
    local lbl = container:FindFirstChildWhichIsA("TextLabel", true)
    if lbl then return lbl end

    return nil
end

