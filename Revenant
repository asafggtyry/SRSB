function Helpers.addSlider(title,key,minimum,maximum,step,format)
    local b=Instance.new("TextButton"); b.Text=""; b.AutoButtonColor=false
    b.BackgroundColor3=C.panel; b.BackgroundTransparency=.57; b.BorderSizePixel=0
    b.LayoutOrder=#toggleRows+1; b.Parent=sc; corner(b,19); stroke(b,.86)
    text(b,title,16,4,190,22,12)
    local value=text(b,"",214,4,122,22,11,C.muted); value.TextXAlignment=Enum.TextXAlignment.Right
    local bar=frame(b,16,36,318,4,C.text,.75,2)
    local fill=frame(bar,0,0,0,4,C.purple,0,2)
    local knob=frame(bar,0,-4,12,12,C.purple,0,6)
    local function paint()
        local alpha=(Settings[key]-minimum)/(maximum-minimum)
        fill.Size=UDim2.new(alpha,0,1,0); knob.Position=UDim2.new(alpha,-6,0,-4)
        value.Text=string.format(format or "%g",Settings[key])
    end
    local dragging=nil
    local function update(input)
        local alpha=math.clamp((input.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        Settings[key]=math.clamp(minimum+math.floor(alpha*(maximum-minimum)/step+.5)*step,minimum,maximum)
        if key=="WalkSpeed" and not Safety.paused then S.SpeedHack=true; if refreshList.SpeedHack then refreshList.SpeedHack() end end
        paint()
    end
    b.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=input; update(input) end
    end)
    sliderConnections[#sliderConnections+1]=UserInputService.InputChanged:Connect(function(input)
        if dragging and (input==dragging or input.UserInputType==Enum.UserInputType.MouseMovement) then update(input) end
    end)
    sliderConnections[#sliderConnections+1]=UserInputService.InputEnded:Connect(function(input) if input==dragging then dragging=nil end end)
    toggleRows[#toggleRows+1]={button=b,category="Movement"}; paint()
end
