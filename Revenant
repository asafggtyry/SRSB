local lastHouseFarm=-math.huge
local houseBusy=false
local houseAttempts=setmetatable({}, {__mode="k"})
local unsafeHouses=setmetatable({}, {__mode="k"})
local houseIndex={}
local houseIndexAt=-math.huge
function Helpers.houseCollected(owner)
    return owner and owner:GetAttribute("WasCollected")==true
end
function Helpers.houseOwner(prompt,fallback)
    local map=workspace:FindFirstChild("HalloweenMap")
    local houses=map and map:FindFirstChild("Houses")
    local node=prompt.Parent
    while houses and node and node~=houses do
        if node.Parent==houses then return node end
        node=node.Parent
    end
    return fallback or prompt.Parent
end
function Helpers.houseAvailable(prompt,owner)
    if not prompt or not prompt.Parent or not prompt.Enabled or not prompt:IsDescendantOf(workspace) or unsafeHouses[owner] then return false end
    local node=prompt
    while node and node~=workspace do
        if Helpers.houseCollected(node) or node:GetAttribute("Enabled")==false then return false end
        if node==owner then break end
        node=node.Parent
    end
    return true
end
function Helpers.houseCandidates(char,hrp,hum)
    if os.clock()-houseIndexAt>=5 then
        local entries,seen={},{}
        local function add(prompt,fallback)
            if seen[prompt] then return end
            seen[prompt]=true
            entries[#entries+1]={prompt=prompt,owner=Helpers.houseOwner(prompt,fallback)}
        end
        for _,door in ipairs(CollectionService:GetTagged("Door")) do
            if door:IsDescendantOf(workspace) then
                for _,prompt in ipairs(door:GetDescendants()) do if prompt:IsA("ProximityPrompt") then add(prompt,door) end end
            end
        end
        local map=workspace:FindFirstChild("HalloweenMap")
        local houses=map and map:FindFirstChild("Houses")
        if houses then
            for _,prompt in ipairs(houses:GetDescendants()) do if prompt:IsA("ProximityPrompt") then add(prompt,prompt.Parent) end end
        end
        houseIndex=entries; houseIndexAt=os.clock()
    end
    local candidates={}
    local minions=getMinions()
    local counts={total=#houseIndex,ready=0,cooldown=0,unavailable=0,hazard=0,enemies=0,blocked=0}
    for _,entry in ipairs(houseIndex) do
        local prompt,owner=entry.prompt,entry.owner
        local attempt=houseAttempts[prompt]
        if attempt and attempt.exhaustedRound==(tonumber(workspace:GetAttribute("Round")) or 1) then counts.unavailable=counts.unavailable+1
        elseif unsafeHouses[owner] or (attempt and attempt.unsafe) then counts.blocked=counts.blocked+1
        elseif not Helpers.houseAvailable(prompt,owner) then counts.unavailable=counts.unavailable+1
        elseif attempt and os.clock()<attempt.nextTry then counts.cooldown=counts.cooldown+1
        elseif Helpers.hazardMarked(prompt) then counts.hazard=counts.hazard+1
        else
            local position=promptPosition(prompt)
            if position then
                if Helpers.enemiesNear(position,12,minions) then counts.enemies=counts.enemies+1
                else
                    counts.ready=counts.ready+1
                    candidates[#candidates+1]={prompt=prompt,owner=owner,pos=position,attempt=attempt,
                        score=(position-hrp.Position).Magnitude+(attempt and attempt.failures*40 or 0)}
                end
            else counts.unavailable=counts.unavailable+1 end
        end
    end
    AutoSeq.houseCounts=counts
    table.sort(candidates,function(a,b) return a.score<b.score end)
    return candidates
end
function Helpers.recordHouseFailure(prompt,reason)
    local record=houseAttempts[prompt] or {failures=0,nextTry=0}
    record.failures=math.min((record.failures or 0)+1,8)
    record.nextTry=os.clock()+math.min(30,3*2^(record.failures-1))
    record.reason=reason
    houseAttempts[prompt]=record
    return record
end
function Helpers.houseWaitReason()
    local counts=AutoSeq.houseCounts or {}
    local reason=AutoSeq.houseRejectReason
    if (counts.ready or 0)==0 then
        if (counts.enemies or 0)>0 then reason="enemies within 12 studs"
        elseif (counts.cooldown or 0)>0 then reason=(AutoSeq.houseRejectReason or "door validation").." (retry cooldown)"
        elseif (counts.hazard or 0)>0 then reason="explicit hazard markers"
        elseif (counts.unavailable or 0)>0 then reason="collected or disabled doors"
        elseif (counts.total or 0)==0 then reason="house prompts not loaded" end
    end
    return string.format("House wait: %s | ready %d, cooldown %d, unavailable %d",
        reason or "checking doorways",counts.ready or 0,counts.cooldown or 0,counts.unavailable or 0)
end
function Helpers.visitPromptCandidate(prompt,ctx)
    if not prompt or prompt==ctx.door or not prompt.Parent or not prompt:IsA("ProximityPrompt")
        or not prompt:IsDescendantOf(workspace) then return false end
    local position=promptPosition(prompt)
    if not position or (position-ctx.position).Magnitude>10 then return false end
    local own=ctx.owner.Parent and prompt:IsDescendantOf(ctx.owner)
    local model=prompt:FindFirstAncestorOfClass("Model")
    local humanoid=model and model:FindFirstChildOfClass("Humanoid")
    if model==ctx.char or (model and Players:GetPlayerFromCharacter(model)) then return false end
    local text=((prompt.ActionText or "").." "..(prompt.ObjectText or "")):lower()
    local talk=text:find("talk",1,true) or text:find("candy",1,true) or text:find("collect",1,true)
        or text:find("take",1,true) or text:find("treat",1,true)
    return (own and (talk or humanoid~=nil)) or (humanoid and humanoid.Health>0 and (ctx.initial[prompt]~=true))
end
function Helpers.queueVisitPrompt(prompt,ctx)
    if Helpers.visitPromptCandidate(prompt,ctx) and not ctx.queued[prompt] then
        ctx.queued[prompt]=true; ctx.prompts[#ctx.prompts+1]=prompt
    end
end
function Helpers.scanVisitPrompts(ctx,baseline)
    local seen={}
    local function add(prompt)
        if seen[prompt] then return end
        seen[prompt]=true
        if baseline then ctx.initial[prompt]=prompt.Enabled else Helpers.queueVisitPrompt(prompt,ctx) end
    end
    if baseline and ctx.owner.Parent then
        ctx.ownerPrompts={}
        for _,instance in ipairs(ctx.owner:GetDescendants()) do
            if instance:IsA("ProximityPrompt") then
                ctx.ownerPrompts[#ctx.ownerPrompts+1]=instance; add(instance)
                if #ctx.ownerPrompts>=128 then break end
            end
        end
    elseif ctx.ownerPrompts then
        for _,prompt in ipairs(ctx.ownerPrompts) do if prompt.Parent then add(prompt) end end
    end
    local params=OverlapParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={ctx.char}
    local parts=workspace:GetPartBoundsInRadius(ctx.position,10,params)
    local models={}
    for i=1,math.min(#parts,64) do
        local part=parts[i]
        for _,instance in ipairs(part:GetChildren()) do if instance:IsA("ProximityPrompt") then add(instance)
            elseif instance:IsA("Attachment") then
                for _,child in ipairs(instance:GetChildren()) do if child:IsA("ProximityPrompt") then add(child) end end
            end
        end
        local model=part:FindFirstAncestorOfClass("Model")
        if model and not models[model] and model:FindFirstChildOfClass("Humanoid") then
            models[model]=true
            for _,instance in ipairs(model:GetDescendants()) do if instance:IsA("ProximityPrompt") then add(instance) end end
        end
    end
end
Helpers.housePromptAddedConn=workspace.DescendantAdded:Connect(function(instance)
    local ctx=Helpers.activeHouseVisit
    if Helpers.houseContextLive(ctx) and instance:IsA("ProximityPrompt") then Helpers.queueVisitPrompt(instance,ctx) end
end)
function Helpers.serviceVisitPrompt(ctx,valid)
    if ctx.dialogueObserved and os.clock()-(ctx.lastDialogueAt or 0)<1.25 then return end
    for _,prompt in ipairs(ctx.prompts) do
        local record=ctx.promptAttempts[prompt]
        if prompt.Parent and prompt.Enabled and Helpers.visitPromptCandidate(prompt,ctx)
            and (not record or (record.count<2 and os.clock()-record.at>=1)) then
            local char,hrp,hum=getChar()
            local position=promptPosition(prompt)
            if not char or not hrp or not hum or not position or not valid() then return end
            ctx.promptAttempts[prompt]={count=record and record.count or 0,at=os.clock()}
            if (hrp.Position-position).Magnitude>prompt.MaxActivationDistance then
                local point=Helpers.doorStandSpot(prompt,char,hrp,hum,getMinions(),false)
                if not point then ctx.phase="npc_out_of_range"; return end
                moveOnce(prompt,CFrame.lookAt(point,Vector3.new(position.X,point.Y,position.Z)),2)
            end
            ctx.phase="npc_prompt"; ctx.npcObserved=true
            ctx.promptAttempts[prompt]={count=record and record.count+1 or 1,at=os.clock()}
            ctx.deadline=math.min(ctx.hardDeadline,math.max(ctx.deadline,os.clock()+1.25))
            firePrompt(prompt,valid,false,true)
            return
        end
    end
end

local function farmOneHouse()
    if Safety.paused or houseBusy or tick()-lastHouseFarm<.3 then return "cooldown" end
    local char,hrp,hum=getChar()
    if not char or not hrp or not hum or hum.Health<=0 or hrp.Anchored then return "blocked" end
    local generation=AutoSeq.generation
    local automatic=S.AutoComplete
    local visitRound=tonumber(workspace:GetAttribute("Round")) or 1
    local function running()
        if Safety.paused or not sg.Parent or AutoSeq.generation~=generation or LocalPlayer.Character~=char or hum.Health<=0 then return false end
        if (tonumber(workspace:GetAttribute("Round")) or 1)~=visitRound then return false end
        local health=automatic and Helpers.corniferHealth() or nil
        if health and health<=0 then return false end
        if automatic then return autoAlive() and AutoSeq.state=="farm" end
        return S.AutoFarmHouses and not S.AutoComplete
    end
    if not running() then return "blocked" end
    local chosen
    local candidates=Helpers.houseCandidates(char,hrp,hum)
    local minions=getMinions()
    -- At most two candidate geometries per attempt, stopping on the first valid landing.
    for i=1,math.min(2,#candidates) do
        local candidate=candidates[i]
        local relaxed=(AutoSeq.emptyHousePasses or 0)>=2
        local point,reason=Helpers.doorStandSpot(candidate.prompt,char,hrp,hum,minions,relaxed)
        if point then candidate.stand=point; chosen=candidate; break end
        Helpers.recordHouseFailure(candidate.prompt,reason or "no landing")
    end
    if not chosen then
        AutoSeq.emptyHousePasses=(AutoSeq.emptyHousePasses or 0)+1
        AutoSeq.reason=Helpers.houseWaitReason(); setStatus(AutoSeq.reason)
        lastHouseFarm=tick()+.7
        return "none"
    end
    AutoSeq.emptyHousePasses=0
    houseBusy=true
    local baselineHP=hum.Health
    local unsafe=false
    local damageConn,contactConn
    local arrived=false
    local hazardContactAt=-math.huge
    local function abortUnsafe(reason,temporary,duration)
        if unsafe then return end
        unsafe=true
        if not temporary then unsafeHouses[chosen.owner]=true end
        local record=houseAttempts[chosen.prompt] or {failures=0,nextTry=0}
        record.unsafe=not temporary; record.nextTry=temporary and os.clock()+(duration or 10) or math.huge
        houseAttempts[chosen.prompt]=record
        if not Safety.paused then Helpers.retreatToCornifer(reason) end
    end
    local function damageCheck()
        if baselineHP-hum.Health<math.min(20,hum.MaxHealth/3) then return false end
        if not arrived then AutoSeq.reason="Damage before house arrival, retry paused"; return true end
        local marked=Helpers.hazardMarked(chosen.prompt) or os.clock()-hazardContactAt<=2
        if marked then abortUnsafe("Retreat: hazard contact at this house",false)
        else abortUnsafe("Retreat: damage source unconfirmed, door paused for 60 seconds",true,60) end
        return true
    end
    local function valid()
        if not running() or unsafe then return false end
        return not damageCheck()
    end
    local ok,result=pcall(function()
        if hrp.Touched then
            contactConn=hrp.Touched:Connect(function(part)
                if arrived and Helpers.hazardMarked(part) then hazardContactAt=os.clock() end
            end)
        end
        damageConn=hum.HealthChanged:Connect(function()
            if Safety.enabled and hum.Health<=1 and checkSafety then checkSafety() end
            damageCheck()
        end)
        local prompt,owner=chosen.prompt,chosen.owner
        local beforeBag=getBagCount()
        local beforeAttribute=tonumber(char:GetAttribute("CollectedCandy")) or 0
        local position=promptPosition(prompt)
        if not position then return "retry" end
        local ctx={active=true,char=char,generation=generation,door=prompt,owner=owner,position=position,
            initial={},queued={},prompts={},promptAttempts={},startedAt=os.clock(),deadline=os.clock()+2.5,
            hardDeadline=os.clock()+5,dialogueObserved=false,responses=0,phase="positioning",beforeBag=beforeBag}
        Helpers.activeHouseVisit=ctx
        local record=houseAttempts[prompt] or {failures=0,nextTry=0}
        record.pending=true; record.phase=ctx.phase; houseAttempts[prompt]=record
        Helpers.scanVisitPrompts(ctx,true)
        local yieldRecorded=false
        local baselineAmount=math.max(beforeBag,beforeAttribute)
        local function confirmed()
            if not ctx.knocked then return false end
            local after=math.max(getBagCount(),tonumber(char:GetAttribute("CollectedCandy")) or 0)
            if after>baselineAmount then
                if not yieldRecorded then Helpers.recordHouseYield(baselineAmount,after,bagMax()); yieldRecorded=true end
                ctx.phase="confirmed"; ctx.confirmedAt=os.clock(); record.confirmedAt=ctx.confirmedAt
                return true
            end
            return false
        end
        local function waitSafe(seconds)
            local untilTime=os.clock()+seconds
            repeat
                if not valid() then return false end
                if Helpers.enemiesNear(hrp.Position,12) then abortUnsafe("Retreat: enemies appeared at this house",true); return false end
                if confirmed() then return true end
                task.wait(.05)
            until os.clock()>=untilTime
            return valid()
        end
        local function doorNearby()
            local pos=promptPosition(prompt)
            return valid() and pos and (hrp.Position-pos).Magnitude<=prompt.MaxActivationDistance
        end
        local point=chosen.stand
        moveOnce(prompt,CFrame.lookAt(point,Vector3.new(position.X,point.Y,position.Z)),2)
        arrived=true
        if not waitSafe(.05) then return unsafe and "unsafe" or "blocked" end
        ctx.phase="knock"; ctx.knocked=true; record.phase=ctx.phase
        firePrompt(prompt,doorNearby,false,false)
        ctx.startedAt=os.clock(); ctx.deadline=os.clock()+2.5; ctx.hardDeadline=os.clock()+5
        local nextScan=0
        local assisted=false
        while os.clock()<ctx.deadline do
            if not valid() then return unsafe and "unsafe" or "blocked" end
            if confirmed() then return "ok" end
            if os.clock()>=nextScan then
                Helpers.scanVisitPrompts(ctx,false); nextScan=os.clock()+.25
            end
            Helpers.serviceVisitPrompt(ctx,valid)
            if not valid() then return unsafe and "unsafe" or "blocked" end
            if confirmed() then return "ok" end
            -- A second knock is only attempted if no NPC or dialogue has responded.
            if not assisted and os.clock()-ctx.startedAt>=.8 and not ctx.dialogueObserved and not ctx.npcObserved
                and prompt.Parent and prompt.Enabled then
                assisted=true; ctx.phase="knock_retry"
                firePrompt(prompt,doorNearby,false,true)
            end
            record.phase=ctx.phase
            AutoSeq.reason=string.format("House pending: %s | NPC %s | dialogue %s",ctx.phase,
                ctx.npcObserved and "seen" or "waiting",ctx.dialogueObserved and "seen" or "waiting")
            if not waitSafe(.05) then return unsafe and "unsafe" or "blocked" end
        end
        -- Keep ownership of a delayed bag update briefly before starting a different house.
        ctx.phase="reward_settle"
        local settleUntil=math.min(ctx.hardDeadline,os.clock()+1)
        while os.clock()<settleUntil do
            if not valid() then return unsafe and "unsafe" or "blocked" end
            if confirmed() then return "ok" end
            if not waitSafe(.05) then return unsafe and "unsafe" or "blocked" end
        end
        if confirmed() then return "ok" end
        local consumed=not prompt.Parent or not owner.Parent or Helpers.houseCollected(owner)
        record.dialogueObserved=ctx.dialogueObserved; record.npcObserved=ctx.npcObserved
        if consumed then
            record.exhaustedRound=tonumber(workspace:GetAttribute("Round")) or 1
            return "consumed_no_reward"
        end
        return ctx.dialogueObserved and "dialogue_no_reward" or "retry"
    end)
    local ctx=Helpers.activeHouseVisit
    if ctx and ctx.door==chosen.prompt then ctx.active=false; Helpers.activeHouseVisit=nil end
    local pendingRecord=houseAttempts[chosen.prompt]
    if pendingRecord then pendingRecord.pending=false end
    if damageConn then damageConn:Disconnect() end
    if contactConn then contactConn:Disconnect() end
    houseBusy=false; lastHouseFarm=tick()
    local record=houseAttempts[chosen.prompt] or {failures=0,nextTry=0}
    if unsafe then
        if record.unsafe then record.nextTry=math.huge end
        AutoSeq.reason=record.unsafe and "Confirmed hazard blocked for this session" or "Door paused temporarily after damage or nearby enemy"
    elseif ok and result=="ok" then
        record.failures=0; record.nextTry=os.clock()+2
        setStatus("houses: candy collected")
    elseif ok and result=="blocked" then record.nextTry=os.clock()+1
    elseif ok and result=="consumed_no_reward" then
        record.nextTry=os.clock()+2
        AutoSeq.reason="House consumed without confirmed candy, skipped for this round"; setStatus(AutoSeq.reason)
    elseif ok and result=="dialogue_no_reward" then
        record.nextTry=os.clock()+15
        AutoSeq.reason="Dialogue observed, reward unconfirmed; door paused for 15 seconds"; setStatus(AutoSeq.reason)
    else
        record.failures=math.min(record.failures+1,5)
        record.nextTry=os.clock()+60
        setStatus("No house interaction/reward confirmation, door paused for 60 seconds")
    end
    houseAttempts[chosen.prompt]=record
    return unsafe and "unsafe" or (ok and result or "retry")
end

