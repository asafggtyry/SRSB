local function depositCandy(hrp)
    local dropZone = workspace:FindFirstChild("DropZone")
    if not dropZone then return false end
    for _, p in ipairs(dropZone:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local parent = p.Parent
            local target
            if parent:IsA("BasePart") then
                target = parent
            elseif parent:IsA("Model") then
                target = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
            end
            if target then
                hrp.CFrame = target.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.3)
                triggerPrompt(p)
                task.wait(1.2)
                return true
            end
            break
        end
    end
    return false
end

local function talkToCornifier(char, hrp)
    local model, cHrp = getCornifier()
    if not (model and cHrp) then return false end
    if (hrp.Position - cHrp.Position).Magnitude > 12 then
        hrp.CFrame = cHrp.CFrame * CFrame.new(0, 3, 8)
        task.wait(0.3)
    end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            triggerPrompt(p)
            task.wait(0.5)
            return true
        end
    end
    return false
end

local function farmCandies(char, hrp)
    if not equipLantern(char) then task.wait(0.5); return end

    local target, minDist = nil, 250
    for _, npc in ipairs(CollectionService:GetTagged("PatrolNPC")) do
        if npc:IsDescendantOf(workspace) and npc:GetAttribute("IsAnomalySpawn") ~= true then
            local mHum = npc:FindFirstChildOfClass("Humanoid")
            local mHrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            if mHum and mHum.Health > 0 and mHrp then
                local d = (mHrp.Position - hrp.Position).Magnitude
                if d < minDist then target, minDist = mHrp, d end
            end
        end
    end

    if target then
        hrp.CFrame = target.CFrame * CFrame.new(0, 10, 0)
        task.wait(0.05)
        slapOnce(char, target)
        task.wait(0.35)
        slapOnce(char, target)
        task.wait(0.4)
        return
    end

    for _, door in ipairs(CollectionService:GetTagged("Door")) do
        if door:IsDescendantOf(workspace)
            and door:GetAttribute("Enabled") == true
            and door:GetAttribute("WasCollected") ~= true
            and door:GetAttribute("Open") ~= true
            and door:GetAttribute("IsAnomaly") ~= true then
            local prompt = door:FindFirstChild("ProximityPrompt", true)
            if prompt and prompt.Enabled then
                local doorPart = prompt.Parent
                if doorPart and doorPart:IsA("BasePart") then
                    hrp.CFrame = doorPart.CFrame * CFrame.new(0, 3, 0)
                    task.wait(0.2)
                    triggerPrompt(prompt)
                    local t0 = tick()
                    while tick() - t0 < 6 do
                        if workspace:GetAttribute("DialogueOpen") == true then break end
                        task.wait(0.1)
                    end
                    local t1 = tick()
                    while tick() - t1 < 5 do
                        if workspace:GetAttribute("DialogueOpen") ~= true then break end
                        task.wait(0.2)
                    end
                    task.wait(0.4)
                    return
                end
            end
        end
    end

    task.wait(0.8)
end

local function defendWave(char, hrp)
    local _, cHrp = getCornifier()
    if not cHrp then task.wait(0.4); return end
    if not equipLantern(char) then task.wait(0.3); return end

    local target, minDist = nil, math.huge
    for _, npc in ipairs(CollectionService:GetTagged("WaveMinion")) do
        if npc:IsDescendantOf(workspace) then
            local mHum = npc:FindFirstChildOfClass("Humanoid")
            local mHrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            if mHum and mHum.Health > 0 and mHrp then
                local d = (mHrp.Position - cHrp.Position).Magnitude
                if d < minDist then target, minDist = mHrp, d end
            end
        end
    end

    if target then
        hrp.CFrame = target.CFrame * CFrame.new(0, 8, 0)
        task.wait(0.05)
        slapOnce(char, target)
        task.wait(0.25)
    else
        if (hrp.Position - cHrp.Position).Magnitude > 30 then
            hrp.CFrame = cHrp.CFrame * CFrame.new(0, 5, 10)
        end
        task.wait(0.25)
    end
end

-- FIXED: search whole model + workspace fallback for prompt
local function collectSoulCandy(hrp)
    local soul = workspace:FindFirstChild("SoulCandy", true)
    if not soul then return false end

    local target
    if soul:IsA("BasePart") then
        target = soul
    elseif soul:IsA("Model") then
        target = soul.PrimaryPart or soul:FindFirstChildWhichIsA("BasePart")
    end
    if not target then return false end

    hrp.CFrame = target.CFrame * CFrame.new(0, 3, 0)
    task.wait(0.3)

    -- Search entire SoulCandy for a prompt
    local prompt = soul:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        -- Fallback: any nearby prompt
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("ProximityPrompt") and p.Enabled then
                local pPart = p.Parent
                if pPart and pPart:IsA("BasePart")
                    and (pPart.Position - target.Position).Magnitude < 15 then
                    prompt = p
                    break
                end
            end
        end
    end
    if prompt then triggerPrompt(prompt) end
    task.wait(0.6)
    return true
end

-- NEW: try to feed Cornifier the SoulCandy (Feed prompt)
local function feedCornifier(hrp)
    local _, cHrp = getCornifier()
    if not cHrp then return false end

    -- Look for a "Feed" prompt near Cornifier
    local feedPrompt
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled
            and p.ActionText and p.ActionText:lower():find("feed") then
            local pPart = p.Parent
            if pPart and pPart:IsA("BasePart")
                and (pPart.Position - cHrp.Position).Magnitude < 25 then
                feedPrompt = p
                break
            end
        end
    end

    if not feedPrompt then return false end
    hrp.CFrame = cHrp.CFrame * CFrame.new(0, 3, 8)
    task.wait(0.3)
    triggerPrompt(feedPrompt)
    task.wait(1)
    return true
end

-- FIXED: specific glove name + safe fallback
local function tryRetrieveGlove(hrp)
    local SPECIFIC_NAMES = { "RevenantGlove", "Revenant", "Glove" }

    local candidates = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, name in ipairs(SPECIFIC_NAMES) do
                if obj.Name == name then
                    table.insert(candidates, obj)
                    break
                end
            end
        end
    end

    local endSeq = workspace:FindFirstChild("EndSequence")
    if endSeq then
        for _, obj in ipairs(endSeq:GetDescendants()) do
            if obj:IsA("BasePart") then
                for _, name in ipairs(SPECIFIC_NAMES) do
                    if obj.Name == name then
                        table.insert(candidates, obj)
                        break
                    end
                end
            end
        end
    end

    if #candidates > 0 then
        local t = candidates[1]
        hrp.CFrame = t.CFrame * CFrame.new(0, 3, 0)
        task.wait(0.4)
        local prompt = t:FindFirstChildWhichIsA("ProximityPrompt", true)
            or (t.Parent and t.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
        if prompt then
            triggerPrompt(prompt)
            task.wait(1.5)
            return true
        end
    end

    -- Fallback: any prompt NOT on a Door or DropZone
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local model = obj:FindFirstAncestorOfClass("Model")
            local isDoor = model and model:HasTag("Door")
            local isDropZone = model and model:HasTag("DropZone")
            if not isDoor and not isDropZone then
                local basePart = model and (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
                if basePart then
                    hrp.CFrame = basePart.CFrame * CFrame.new(0, 3, 0)
                    task.wait(0.4)
                    triggerPrompt(obj)
                    task.wait(1.5)
                    return true
                end
            end
        end
    end

    return false
end

