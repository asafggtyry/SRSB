-- Local hazard names and explicit attributes; decorative ancestor names are ignored.
function Helpers.hazardMarked(obj)
    if not obj then return false end
    local name=obj.Name:lower():gsub("[%s_%-]", "")
    if name:match("^lava%d*$") or name:match("^killbrick%d*$")
        or name:match("^killzone%d*$") or name:match("^hazard%d*$") then return true end
    local node=obj
    while node and node~=workspace do
        for _,key in ipairs({"Hazard","KillZone","IsTrap"}) do
            local value=node:GetAttribute(key)
            if value==true or (type(value)=="number" and value>0) then return true end
        end
        node=node.Parent
    end
    return false
end
