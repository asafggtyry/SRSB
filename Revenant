local function onWindow(point)
    local over=false
    for _,obj in ipairs(PlayerGui:GetGuiObjectsAtPosition(point.X,point.Y)) do
        if obj:IsDescendantOf(mf) then
            over=true
            local node=obj
            while node and node~=mf do
                if node:IsA("GuiButton") or node:IsA("TextBox") or node:IsA("ScrollingFrame") then return false end
                node=node.Parent
            end
        end
    end
    return over
end
