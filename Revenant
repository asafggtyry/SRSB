local lastAuto=0
local AUTO_INTERVAL=.08
local function setAutoStage(stage,reason)
    local changed=AutoSeq.state~=stage
    if changed then
        if stage~="startwave" and stage~="defend" then AutoSeq.voteFiredAt=nil; AutoSeq.voteDeadline=nil; AutoSeq.voteBaseline=nil end
        local previous=AutoSeq.state
        AutoSeq.state=stage; AutoSeq.enteredAt=os.clock()
        AutoSeq.promptAttemptAt=-math.huge; AutoSeq.promptAttempts=0
        traceAuto(previous.." -> "..stage..": "..(reason or "game state changed"))
    elseif reason then
        AutoSeq.reason=reason
    end
    local farming=stage=="farm"
    local defending=stage=="defend" or stage=="defend2"
    if changed and not defending and releaseCombatHold then releaseCombatHold() end
    local refresh=changed or S.AutoFarmHouses~=farming or S.AutoDeposit~=(stage=="deposit") or S.AutoDefend~=defending or S.Noclip
    S.AutoFarmHouses=farming; S.AutoDeposit=stage=="deposit"; S.AutoDefend=defending
    S.Noclip=false
    if refresh then refreshToggles() end
end
