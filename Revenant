local function facePrompt(prompt)
    local camera=workspace.CurrentCamera
    if not camera or not prompt or not prompt.Parent then return function() end end
    local parent=prompt.Parent
    local pos
    if parent:IsA("Attachment") then pos=parent.WorldPosition
    elseif parent:IsA("BasePart") then pos=parent.Position
    elseif parent:IsA("Model") then
        local part=parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart",true)
        pos=part and part.Position
    end
    if not pos then return function() end end
    if releasePromptCamera then releasePromptCamera() end
    local oldType,oldFrame,oldSubject=camera.CameraType,camera.CFrame,camera.CameraSubject
    local _,hrp=getChar()
    local from=hrp and hrp.Position+Vector3.new(0,2.5,0) or pos+Vector3.new(0,2.5,4)
    local aim=CFrame.lookAt(from,pos)
    camera.CameraType=Enum.CameraType.Scriptable; camera.CFrame=aim
    local conn=RunService.RenderStepped:Connect(function()
        if sg.Parent and workspace.CurrentCamera==camera then camera.CFrame=aim end
    end)
    local released=false
    local function release()
        if released then return end
        released=true; conn:Disconnect()
        pcall(function()
            camera.CFrame=oldFrame
            camera.CameraSubject=oldSubject
            camera.CameraType=oldType
        end)
        releasePromptCamera=nil
    end
    releasePromptCamera=release
    return release
end
sg.Destroying:Connect(function() if releasePromptCamera then releasePromptCamera() end end)
local function firePrompt(prompt,valid,manualOnly,aimCamera)
    local function allowed()
        if Safety.paused or not sg.Parent or not prompt or not prompt.Parent then return false end
        if activeAutoToken and not autoAlive() then return false end
        return not valid or valid()
    end
    if not allowed() then return false end
    local aim=aimCamera~=false
    local release=aim and facePrompt(prompt) or function() end
    local began=false
    local ok,result=pcall(function()
        if aim then task.wait(.06) end
        if not allowed() then return false end
        if not manualOnly and type(fireproximityprompt)=="function" then
            if pcall(fireproximityprompt,prompt) then return true end
        end
        -- Input is attempted even during a local Enabled cooldown. Callers still verify outcomes.
        prompt:InputHoldBegin(); began=true
        local deadline=os.clock()+math.max(0,prompt.HoldDuration)+.05
        while os.clock()<deadline do
            if not allowed() then return false end
            task.wait(.03)
        end
        return true
    end)
    if began then pcall(function() prompt:InputHoldEnd() end) end
    release()
    return ok and result==true
end

