Helpers.houseLandings=setmetatable({}, {__mode="k"})
function Helpers.resolveDoorPart(prompt)
    local fallback=promptPart(prompt)
    local node=prompt.Parent
    for _=1,5 do
        if not node or node==workspace then break end
        for _,name in ipairs({"DoorPanel","DoorPart","FrontDoor","Door"}) do
            local candidate=node.Name==name and node or node:FindFirstChild(name)
            local part=candidate and Helpers.findBasePart(candidate)
            if part then return part,true end
        end
        node=node.Parent
    end
    return fallback,false
end
function Helpers.doorStandSpot(prompt,char,hrp,hum,minions,relaxed)
    local position=promptPosition(prompt)
    local part,doorTrusted=Helpers.resolveDoorPart(prompt)
    if not position or not part then return Helpers.rejectHouse("prompt host missing") end
    local reach=tonumber(prompt.MaxActivationDistance) or 0
    if reach<=.2 then return Helpers.rejectHouse("activation range too small") end
    local cached=Helpers.houseLandings[prompt]
    if cached and cached.part==part and cached.floor.Parent and cached.floor.CanCollide
        and (part.Position-cached.partPosition).Magnitude<.5
        and (cached.floor.Position-cached.floorPosition).Magnitude<.5
        and math.abs(cached.lift-(hum.HipHeight+hrp.Size.Y*.5))<.25
        and (cached.point-position).Magnitude<=reach-.05 and not Helpers.hazardMarked(cached.floor) then return cached.point end
    local cf=part.CFrame
    local look=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
    if look.Magnitude<.1 then
        local cross=cf.RightVector:Cross(Vector3.new(0,1,0))
        look=Vector3.new(cross.X,0,cross.Z)
    end
    if look.Magnitude<.1 then look=Vector3.new(hrp.Position.X-part.Position.X,0,hrp.Position.Z-part.Position.Z) end
    if look.Magnitude<.1 then look=Vector3.new(1,0,0) else look=look.Unit end
    if (hrp.Position-part.Position):Dot(look)<0 then look=-look end
    local right=Vector3.new(-look.Z,0,look.X)
    local feet=hrp.Position.Y-(hum.HipHeight+hrp.Size.Y*.5)
    local floorEstimate=doorTrusted and part.Position.Y-math.min(part.Size.Y*.5,3) or feet
    local ground={originY=math.max(part.Position.Y,floorEstimate+2),maxFloorY=floorEstimate+(doorTrusted and 1.5 or 4)}
    local search=Helpers.houseSpotSearch[prompt]
    if not search or search.relaxed~=relaxed or search.reach~=reach or (search.position-part.Position).Magnitude>1 then
        local samples,used={},{}
        for _,distance in ipairs({math.min(3,reach*.45),math.min(1.5,reach*.25),2.5,3.5,5,7}) do
            local rounded=math.floor(distance*100+.5)
            if distance>0 and distance<reach and not used[rounded] then
                used[rounded]=true
                for i=0,7 do
                    local angle=i*math.pi/4
                    samples[#samples+1]=part.Position+(look*math.cos(angle)+right*math.sin(angle))*distance
                end
            end
        end
        search={cursor=1,samples=samples,position=part.Position,reach=reach,relaxed=relaxed}
        Helpers.houseSpotSearch[prompt]=search
    end
    local lastReason=search.lastReason or "no usable sample"
    -- The outward sample usually succeeds on one ground ray. Fallback search stays bounded.
    for _=1,4 do
        if search.cursor>#search.samples then search.cursor=1; break end
        local raw=search.samples[search.cursor]; search.cursor=search.cursor+1
        local point,reason,floor=Helpers.standSpot(raw,char,hrp,hum,minions,true,relaxed,ground)
        if point then
            if (point-position).Magnitude<=reach-.05 then
                Helpers.houseLandings[prompt]={point=point,part=part,partPosition=part.Position,floor=floor,
                    floorPosition=floor.Position,lift=hum.HipHeight+hrp.Size.Y*.5}
                return point
            end
            lastReason="outside 3D activation range"; Helpers.rejectHouse(lastReason)
        else lastReason=reason or "landing rejected" end
    end
    search.lastReason=lastReason
    return nil,lastReason
end

function Helpers.dropDestination()
    local char,hrp,hum=getChar()
    local dz=workspace:FindFirstChild("DropZone")
    local inner=dz and dz:FindFirstChild("DropZone")
    local part=inner and inner:FindFirstChild("Part")
    if not char or not hrp or not hum or not part or not part:IsA("BasePart") then return nil end
    for _,distance in ipairs({4,6,8}) do
        for _,direction in ipairs({part.CFrame.LookVector,-part.CFrame.LookVector,part.CFrame.RightVector,-part.CFrame.RightVector}) do
            local raw=part.Position+direction*distance
            local point=Helpers.standSpot(raw,char,hrp,hum,{},true)
            if point then return CFrame.lookAt(point,Vector3.new(part.Position.X,point.Y,part.Position.Z)) end
        end
    end
    return nil
end

function Helpers.interactDrop(prompt,manualOnly,expectedMode)
    local function ready()
        return not Safety.paused and prompt and prompt.Parent and prompt.Enabled
            and (not expectedMode or Helpers.dropMode(prompt)==expectedMode)
    end
    if not ready() then return false end
    local position=promptPosition(prompt)
    local char,hrp,hum=getChar()
    if not position or not char or not hrp or not hum or hum.Health<=0 then return false end
    if (hrp.Position-position).Magnitude>prompt.MaxActivationDistance*.8 then
        local cf=Helpers.dropDestination()
        if not cf or (cf.Position-position).Magnitude>prompt.MaxActivationDistance then return false end
        moveOnce(prompt,cf,prompt.MaxActivationDistance*.7); task.wait(.1)
    end
    if not ready() then return false end
    return firePrompt(prompt,ready,manualOnly,true)
end
