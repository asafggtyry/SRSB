local function getBagSize()
    local pc = #Players:GetPlayers()
    if pc == 1 then return 2000
    elseif pc == 2 then return 1500
    elseif pc == 3 then return 1000
    else return 600 end
end

local function getDialogueRemotes()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local common = modules and modules:FindFirstChild("Common")
    local ds = common and common:FindFirstChild("DialogueServer")
    return ds and ds:FindFirstChild("Remotes")
end

local function triggerPrompt(prompt)
    if not prompt then return false end
    if typeof(fireproximityprompt) == "function" then
        if pcall(fireproximityprompt, prompt) then return true end
    end
    return pcall(function()
        prompt:InputHoldBegin()
        task.wait((prompt.HoldDuration or 0) + 0.2)
        prompt:InputHoldEnd()
    end)
end

local function getCornifier()
    local dropZone = workspace:FindFirstChild("DropZone")
    if not dropZone then return nil, nil end
    local npcFolder = dropZone:FindFirstChild("NPC")
    if not npcFolder then return nil, nil end
    local npcModel = npcFolder:FindFirstChild("NPC") or npcFolder
    local hrp = npcModel:FindFirstChild("HumanoidRootPart") or npcModel.PrimaryPart
    return npcModel, hrp
end

local function equipLantern(char)
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool.Name == "Lantern" then return tool end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        local lantern = backpack:FindFirstChild("Lantern")
        if lantern then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum:EquipTool(lantern) end)
                task.wait(0.2)
                return char:FindFirstChildOfClass("Tool")
            end
        end
    end
    return nil
end

local function slapOnce(char, targetPart)
    local tool = equipLantern(char)
    if not tool then return false end
    local glove = tool:FindFirstChild("Glove")
    if glove and glove:IsA("BasePart") then
        glove.Size = Vector3.new(25, 25, 25)
        glove.Transparency = 1
        glove.CanCollide = false
    end
    tool:Activate()
    local remote = tool:FindFirstChild("Network")
    if remote then
        remote:FireServer("Hit", targetPart)
        return true
    end
    return false
end

local function isInMainPlace()
    for _, id in ipairs(MAIN_PLACE_IDS) do
        if game.PlaceId == id then return true end
    end
    return false
end

local function isInObtainmentPlace()
    for _, id in ipairs(OBTAINMENT_PLACE_IDS) do
        if game.PlaceId == id then return true end
    end
    return false
end

local function teleportToObtainment()
