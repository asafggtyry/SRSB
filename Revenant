    if not prompt or not prompt.Parent then AutoSeq.reason="Waiting for shared DropZone prompt"; return false end
    if not prompt.Enabled then AutoSeq.reason="Deposit prompt disabled, waiting for readiness"; return false end
    local mode=Helpers.dropMode(prompt)
    if mode~="deposit" then AutoSeq.reason="Waiting for candy count and DropZone mode to agree ("..mode..")"; return false end
    if tick()-lastDepositFire<2 then return false end
    local _,_,hum=getChar()
    if not hum or hum.Health<=0 then return false end
    lastDepositFire=tick()
    Helpers.interactDrop(prompt,math.floor(tick()/3)%2==0,"deposit")
    local deadline=os.clock()+2.5
    repeat
        if activeAutoToken and not autoAlive() then return false end
        if Helpers.candyForDrop(prompt)<before then lastDepositConfirmed=tick(); return true end
        task.wait(.1)
    until os.clock()>=deadline
    AutoSeq.reason="Deposit unconfirmed, re-reading bag and prompt next tick"
    return false
end

function Helpers.enemiesNearCornifer(minions,baseline)
    local _,anchor=findCornifer()
    if not anchor then return false end
    for _,enemy in ipairs(minions or getMinions()) do
        if enemy.hum.Health>0 and (enemy.pos-anchor.Position).Magnitude<=60
            and (not baseline or not baseline[enemy.model]) then return true end
    end
    return false
end
local lastWaveAttempt=-math.huge
local function startWave()
    local now=os.clock()
    if not autoAlive() then return false,"cancelled" end
    local round=tonumber(workspace:GetAttribute("Round")) or 1
    if Helpers.candyForDrop(findDropPrompt())>0 then AutoSeq.voteFiredAt=nil; AutoSeq.voteDeadline=nil; return false,"bag not empty" end
    if AutoSeq.voteFiredAt then
        if now-AutoSeq.voteFiredAt>=.1 then
            if round~=AutoSeq.voteRound then return true,"round changed" end
            if Helpers.enemiesNearCornifer(getMinions(),AutoSeq.voteBaseline) then
                AutoSeq.voteConfirmed=true; AutoSeq.voted=true
                return true,"new wave near Cornifer after vote input"
            end
        end
        if now<AutoSeq.voteDeadline then
            AutoSeq.reason=string.format("Vote sent at %.1f, waiting for wave until %.1f",AutoSeq.voteFiredAt,AutoSeq.voteDeadline)
            return false,"waiting"
        end
        AutoSeq.voteFiredAt=nil; AutoSeq.voteDeadline=nil; AutoSeq.voteBaseline=nil
        AutoSeq.reason="No wave confirmation after 5 seconds, retrying vote"
    end
    local deposited=tonumber(workspace:GetAttribute("DepositedCandy")) or 0
    if deposited<roundQuota(round) then return false,"quota not met" end
    local cooldown=3.5-(tick()-math.max(lastDepositFire,lastDepositConfirmed))
    if cooldown>0 then AutoSeq.reason=string.format("Deposit cooldown: %.1f seconds before voting",cooldown); return false,"cooldown" end
    if now-lastWaveAttempt<1 then return false,"retry cooldown" end
    local prompt=findDropPrompt()
    if not prompt then AutoSeq.reason="Waiting for shared DropZone vote prompt"; return false,"prompt missing" end
    if not prompt.Enabled then AutoSeq.reason="Vote prompt disabled, waiting for readiness"; return false,"prompt disabled" end
    local mode=Helpers.dropMode(prompt)
    if mode~="vote" then AutoSeq.reason="Waiting for Vote/Start mode, prompt says "..mode; return false,"mode mismatch" end
    -- Refresh before sending so stragglers present before this vote cannot confirm this vote.
    local baseline={}
    for _,enemy in ipairs(getMinions(true)) do baseline[enemy.model]=true end
    lastWaveAttempt=now; AutoSeq.startAttempts=AutoSeq.startAttempts+1
    local sent=Helpers.interactDrop(prompt,AutoSeq.startAttempts%2==0,"vote")
    if not autoAlive() then return false,"cancelled" end
    if not sent then AutoSeq.reason="Vote input failed, retrying at DropZone"; return false,"input failed" end
    AutoSeq.voteFiredAt=os.clock(); AutoSeq.voteDeadline=AutoSeq.voteFiredAt+5
    AutoSeq.voteRound=round; AutoSeq.voteBaseline=baseline; AutoSeq.lastVoteAt=AutoSeq.voteFiredAt
    AutoSeq.defenseArmedAt=AutoSeq.voteFiredAt; AutoSeq.defenseArmedRound=round
    AutoSeq.votePoolBefore=deposited; AutoSeq.waveAccepted=false; AutoSeq.waveRound=round
    AutoSeq.reason=string.format("Vote sent at %.1f, waiting for wave until %.1f",AutoSeq.voteFiredAt,AutoSeq.voteDeadline)
    return false,"sent, awaiting confirmation"
end

