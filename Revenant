local function CreateButton(text, stateKey, isAction)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0.9, 0, 0, 32)
    Btn.BackgroundColor3 = if stateKey and States[stateKey] then Color3.fromRGB(0, 170, 0) else Color3.fromRGB(60, 60, 60)
    Btn.Text = text .. (if not isAction then ": " .. (if States[stateKey] then "ON" else "OFF") else "")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.SourceSansBold
    Btn.TextSize = 14
    Btn.Parent = MainFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        if isAction then
            if stateKey == "TP_Cornifier" then
                local dropZone = workspace:FindFirstChild("DropZone")
                if dropZone and dropZone:FindFirstChild("NPC") then
                    local model = dropZone.NPC:FindFirstChild("NPC") or dropZone.NPC
                    if model and model.PrimaryPart then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = model.PrimaryPart.CFrame * CFrame.new(0, 5, 5)
                    end
                end
            elseif stateKey == "ForceRespawn" then
                Btn.Text = "Respawning..."
                local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if Remotes and Remotes:FindFirstChild("RequestRetry") then
                    Remotes.RequestRetry:FireServer()
                end
                task.wait(1)
                Btn.Text = "Force Respawn (Unstick)"
            elseif stateKey == "Rejoin" then
                Btn.Text = "Rejoining Public..."
                local TeleportOptions = Instance.new("TeleportOptions")
                TeleportOptions.ShouldReserveServer = false
                TeleportService:TeleportAsync(game.PlaceId, {LocalPlayer}, TeleportOptions)
            end
        else
            States[stateKey] = not States[stateKey]
            Btn.BackgroundColor3 = if States[stateKey] then Color3.fromRGB(0, 170, 0) else Color3.fromRGB(60, 60, 60)
            Btn.Text = text .. ": " .. (if States[stateKey] then "ON" else "OFF")
        end
    end)
end

local function CreateSlider(text, stateKey, minVal, maxVal)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(0.9, 0, 0, 32)
    SliderFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    SliderFrame.Parent = MainFrame

    local SliderCorner = Instance.new("UICorner")
    SliderCorner.CornerRadius = UDim.new(0, 6)
    SliderCorner.Parent = SliderFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0.5, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. States[stateKey] .. " studs"
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.SourceSansBold
    Label.TextSize = 12
    Label.Parent = SliderFrame

    local BarBg = Instance.new("Frame")
    BarBg.Size = UDim2.new(0.9, 0, 0, 6)
    BarBg.Position = UDim2.new(0.05, 0, 0.7, 0)
    BarBg.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    BarBg.Parent = SliderFrame

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(0, 4)
    BarCorner.Parent = BarBg

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((States[stateKey] - minVal) / (maxVal - minVal), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    Fill.Parent = BarBg

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(0, 4)
    FillCorner.Parent = Fill

    local dragging = false

    local function updateSlider(input)
        local mouseX = input.Position.X
        local barAbsPos = BarBg.AbsolutePosition.X
        local barAbsSize = BarBg.AbsoluteSize.X
        local percentage = math.clamp((mouseX - barAbsPos) / barAbsSize, 0, 1)

        local value = math.floor(minVal + (maxVal - minVal) * percentage)
        States[stateKey] = value
        Fill.Size = UDim2.new(percentage, 0, 1, 0)
        Label.Text = text .. ": " .. value .. " studs"
    end

    BarBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
end

