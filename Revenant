function Helpers.hudHealth()
    local hud=PlayerGui:FindFirstChild("HUD")
    if not hud then return nil,nil end
    for _,label in ipairs(hud:GetDescendants()) do
        if label:IsA("TextLabel") or label:IsA("TextButton") then
            local name=(label.Name.." "..(label.Parent and label.Parent.Name or "")):lower()
            if name:find("health",1,true) or name:find("heart",1,true) or name:match("%f[%a]hp%f[%A]") then
                local value,maximum=label.Text:gsub(",", ""):match("(%d+%.?%d*)%s*/%s*(%d+%.?%d*)")
                value,maximum=tonumber(value),tonumber(maximum)
                if value and maximum and maximum>0 then return value,maximum end
            end
        end
    end
    return nil,nil
end
function Helpers.refreshHealth()
    local _,_,hum=getChar()
    local value,maximum
    if hum then value,maximum=hum.Health,hum.MaxHealth else value,maximum=Helpers.hudHealth() end
    if not value or not maximum or maximum<=0 then
        heartLbl.Text="HP  —"; heartLbl.TextColor3=C.muted; return
    end
    heartLbl.Text=string.format("HP  %g / %g",math.floor(value*10+.5)/10,math.floor(maximum*10+.5)/10)
    if checkSafety then checkSafety() end
    local ratio=math.clamp(value/maximum,0,1)
    heartLbl.TextColor3=ratio>.75 and C.green or (ratio>.4 and C.warn or Color3.fromRGB(255,115,115))
end
function Helpers.bindHealth()
    local _,_,hum=getChar()
    if hum~=healthHum then
        if healthConn then healthConn:Disconnect(); healthConn=nil end
        if maxHealthConn then maxHealthConn:Disconnect(); maxHealthConn=nil end
        healthHum=hum
        if hum then
            healthConn=hum.HealthChanged:Connect(Helpers.refreshHealth)
            maxHealthConn=hum:GetPropertyChangedSignal("MaxHealth"):Connect(Helpers.refreshHealth)
        end
    end
    Helpers.refreshHealth()
end
