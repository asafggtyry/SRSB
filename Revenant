local combatTarget
local function defendCornifer()
    local char,hrp,hum = getChar()
    if not char or not hrp or not hum or hum.Health<=0 then return end
    if hum.RootPart and hum.RootPart.Anchored then return end
    if not Helpers.combatReady(hum) then return end

    local _, corniPart = findCornifer()
    local minions = getMinions()

    local near = {}
    if corniPart then
        for _, m in ipairs(minions) do
            if (m.pos - corniPart.Position).Magnitude <= 60 then table.insert(near, m) end
        end
    else
        near = minions
    end

    if #near == 0 then
        releaseCombatHold(); combatTarget=nil
        if corniPart then
            local idle=Helpers.defenseIdle
            local horizontal=Vector3.new(hrp.Position.X-corniPart.Position.X,0,hrp.Position.Z-corniPart.Position.Z).Magnitude
            if not idle or idle.char~=char or idle.anchor~=corniPart or horizontal>45 then
                moveOnce(corniPart,CFrame.new(corniPart.Position + Vector3.new(0,4,0)),8)
                Helpers.defenseIdle={char=char,anchor=corniPart}
            end
        end
        return
    end
    Helpers.defenseIdle=nil

    local target, best = nil, math.huge
    for _,m in ipairs(near) do if m.model==combatTarget then target=m; break end end
    for _, m in ipairs(near) do
        local d = (m.pos - hrp.Position).Magnitude
        if not target or (not combatTarget and d<best) then best=d; target=m end
    end
    if target then combatTarget=target.model; slapTarget(target) else combatTarget=nil end
end

