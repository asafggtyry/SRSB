-- Helper: reliable ProximityPrompt trigger
local function triggerPrompt(prompt, anchorPart)
    local anchored = false
    if anchorPart then
        anchorPart.Anchored = true
        anchored = true
    end

    local fired = false
    if typeof(fireproximityprompt) == "function" then
        fired = pcall(fireproximityprompt, prompt)
    end
    if not fired then
        pcall(function()
            prompt:InputHoldBegin()
            task.wait((prompt.HoldDuration or 0) + 0.15)
            prompt:InputHoldEnd()
        end)
    end

    if anchored and anchorPart then
        anchorPart.Anchored = false
    end

    return fired
end

-- 4. Auto Farm Houses (FIXED)
task.spawn(function()
    while task.wait(0.5) do
        if not States.AutoFarm then continue end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and char:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0) then
            continue
        end

        local hrp = char.HumanoidRootPart

        -- Real bag size based on player count
        local pc = #Players:GetPlayers()
        local bagSize = 600
        if pc == 1 then
            bagSize = 2000
        elseif pc == 2 then
            bagSize = 1500
        elseif pc == 3 then
            bagSize = 1000
        end

        local collected = char:GetAttribute("CollectedCandy") or 0
        local bagFull = collected >= bagSize

        if bagFull then
            -- ============ DEPOSIT ============
            local dropZone = workspace:FindFirstChild("DropZone")
            if dropZone then
                local done = false
                for _, p in ipairs(dropZone:GetDescendants()) do
                    if p:IsA("ProximityPrompt")
                        and (p.ActionText == "Deposit Candy" or p.ActionText == "Vote Start")
                        and p.Enabled then

                        local parent = p.Parent
                        local target
                        if parent:IsA("BasePart") then
                            target = parent
                        elseif parent:IsA("Model") then
                            target = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
                        end

                        if target then
                            hrp.CFrame = target.CFrame * CFrame.new(0, 3, 0)
                            task.wait(0.2)
                            triggerPrompt(p, hrp)
                            task.wait(0.4)
                            done = true
                        end
                        break
                    end
                end
                if not done then task.wait(0.5) end
            end
        else
            -- ============ FARM DOORS ============
            local doors = CollectionService:GetTagged("Door")
            local handled = false

            for _, door in ipairs(doors) do
                if door:GetAttribute("Enabled") and not door:GetAttribute("WasCollected") then
                    local prompt = door:FindFirstChild("ProximityPrompt", true)
                    if prompt and prompt.Enabled then
                        local doorPart = prompt.Parent
                        if doorPart and doorPart:IsA("BasePart") then
                            hrp.CFrame = doorPart.CFrame * CFrame.new(0, 3, 0)
                            task.wait(0.2)

                            triggerPrompt(prompt, hrp)

                            local t0 = tick()
                            local opened = false
                            while tick() - t0 < 7 do
                                if workspace:GetAttribute("DialogueOpen") == true then
                                    opened = true
                                    break
                                end
                                task.wait(0.1)
                            end

                            if opened then
                                task.wait(0.6)
                                local dr = ReplicatedStorage:FindFirstChild("Modules")
                                    and ReplicatedStorage.Modules:FindFirstChild("Common")
                                    and ReplicatedStorage.Modules.Common:FindFirstChild("DialogueServer")
                                    and ReplicatedStorage.Modules.Common.DialogueServer:FindFirstChild("Remotes")
                                local respond = dr and dr:FindFirstChild("ResondToDialogue")
                                if respond then
                                    respond:FireServer(1) -- "* accept candy *"
                                end
                                task.wait(1.5)
                            else
                                task.wait(0.5)
                            end

                            handled = true
                            break
                        end
                    end
                end
            end

            if not handled then task.wait(1) end
        end
    end
end)

