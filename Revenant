end
function Helpers.findDialogueSkip()
    local cache=Helpers.dialogueSkipCache
    if not cache or os.clock()-cache.at>=1 then
        cache={at=os.clock(),buttons={}}
        for _,instance in ipairs(PlayerGui:GetDescendants()) do
            if instance:IsA("GuiButton") then
                local label=instance.Name
                if instance:IsA("TextButton") then label=label.." "..instance.Text end
                local child=instance:FindFirstChildWhichIsA("TextLabel",true)
                if child then label=label.." "..child.Text end
                label=label:lower():gsub("[%s_%-]", "")
                local node,scoped=instance.Parent,false
                while node and node~=PlayerGui do
                    local name=node.Name:lower()
                    if name:find("dialog",1,true) or name:find("conversation",1,true) then scoped=true; break end
                    node=node.Parent
                end
                if label:find("skipdialog",1,true) or (scoped and (label:find("skip",1,true) or label:find("continue",1,true) or label:find("next",1,true))) then
                    cache.buttons[#cache.buttons+1]=instance
                end
            end
        end
        Helpers.dialogueSkipCache=cache
    end
    for _,button in ipairs(cache.buttons) do if Helpers.dialogueButtonVisible(button) then return button end end
end
function Helpers.skipEndingDialogue()
    local reply=Helpers.endingDialogueReply
    if reply and not reply.sent and reply.generation==AutoSeq.generation and type(reply.options)=="table" and next(reply.options) then
        reply.sent=pcall(function() reply.remote:FireServer(1) end)
    end
    local button=Helpers.findDialogueSkip()
    if button and os.clock()-(Helpers.dialogueSkipAt or -math.huge)>=.35 then
        Helpers.dialogueSkipAt=os.clock()
        local activated=false
        if type(firesignal)=="function" then
            activated=pcall(function() firesignal(button.MouseButton1Click); firesignal(button.Activated) end)
        end
        if not activated then
            pcall(function()
                local input=game:GetService("VirtualInputManager")
                local center=button.AbsolutePosition+button.AbsoluteSize*.5
                input:SendMouseButtonEvent(center.X,center.Y,0,true,game,0)
                input:SendMouseButtonEvent(center.X,center.Y,0,false,game,0)
            end)
        end
