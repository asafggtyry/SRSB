-- 1. Fast Loop (Noclip / Fly / Panic)
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Noclip
    if States.Noclip and hum.Health > 0 then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
        end
    end

    ---------------------------------------------------------------
    -- PANIC TOGGLE (stay safe in void while ON, restore on OFF)
    ---------------------------------------------------------------
    if States.Panic and hum.Health > 0 then
        if PanicCharacter ~= char then
            -- Respawned while panic was on; forget old restore point
            PanicCharacter = char
            PanicCFrame = nil
        elseif not PanicCFrame then
            PanicCFrame = hrp.CFrame
        end
        hrp.CFrame = CFrame.new(0, 5000, 0)
        hrp.Anchored = true
        if hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    elseif PanicCharacter then
        if hrp then
            hrp.Anchored = false
            if LocalPlayer.Character == PanicCharacter and PanicCFrame then
                hrp.CFrame = PanicCFrame
            end
        end
        PanicCharacter = nil
        PanicCFrame = nil
    end

    ---------------------------------------------------------------
    -- FLY (camera-relative with vertical control)
    ---------------------------------------------------------------
    if States.Fly and hum.Health > 0 then
        hum.PlatformStand = true

        local bv = hrp:FindFirstChild("FlyBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FlyBV"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
        end

        local bg = hrp:FindFirstChild("FlyBG")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "FlyBG"
            bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            bg.P = 10000
            bg.D = 500
            bg.Parent = hrp
        end

        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end

        if dir.Magnitude > 0 then
            bv.Velocity = dir.Unit * States.FlySpeed
        else
            bv.Velocity = Vector3.zero
        end
        bg.CFrame = cam.CFrame
    else
        local bv = hrp:FindFirstChild("FlyBV")
        local bg = hrp:FindFirstChild("FlyBG")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        if hum.PlatformStand then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Landed)
        end
    end

    if States.SpeedHack then
        hum.WalkSpeed = States.WalkSpeed
        hum.JumpPower = States.JumpPower
    end
end)

-- 2. Auto Slap Loop
task.spawn(function()
    while task.wait() do
        if States.AutoSlap then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local tool = char:FindFirstChildOfClass("Tool")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and tool and tool.Name == "Lantern" and hum and hum.Health > 0 then
                    local closestTarget = nil
                    local shortestDistance = States.SlapRange

                    for _, tag in ipairs({"PatrolNPC", "WaveMinion"}) do
                        for _, npc in ipairs(CollectionService:GetTagged(tag)) do
                            if npc:IsDescendantOf(workspace) then
                                local mHum = npc:FindFirstChildOfClass("Humanoid")
                                local mHrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart

                                if mHum and mHum.Health > 0 and mHrp then
                                    local distance = (hrp.Position - mHrp.Position).Magnitude
                                    if distance <= shortestDistance then
                                        closestTarget = mHrp
                                        shortestDistance = distance
                                    end
                                end
                            end
                        end
                    end

                    if closestTarget then
                        hrp.CFrame = closestTarget.CFrame * CFrame.new(0, 15, 0)
                        task.wait(0.05)

                        local glove = tool:FindFirstChild("Glove")
                        if glove and glove:IsA("BasePart") then
                            glove.Size = Vector3.new(25, 25, 25)
                            glove.Transparency = 1
                            glove.CanCollide = false
                        end

                        tool:Activate()
                        local remote = tool:FindFirstChild("Network")
                        if remote then remote:FireServer("Hit", closestTarget) end

                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)

