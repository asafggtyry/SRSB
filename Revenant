    local mode=Helpers.dropMode(prompt)
    if attribute and ((mode=="vote" and attribute==0) or (mode=="deposit" and attribute>0)) then
        return attribute,true,"character candy agrees with prompt"
    end
    return bag,AutoSeq.bagReadable~=false,"HUD or character candy"
end
