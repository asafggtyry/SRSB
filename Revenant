-- 📊 FPS COUNTER
-- ==========================================
local currentFPS = 0
do
    local frames = 0
    local lastCheck = tick()
    RunService.RenderStepped:Connect(function()
        frames += 1
        local now = tick()
        if now - lastCheck >= 1 then
            currentFPS = math.floor(frames / (now - lastCheck) + 0.5)
            frames = 0
            lastCheck = now
        end
    end)
end

