    return button~=nil or os.clock()-(AutoSeq.dialogueAt or 0)<.4
end
function Helpers.advanceEnding(phase,reason)
    AutoSeq.endingPhase=phase; AutoSeq.endingPhaseAt=os.clock(); AutoSeq.reason=reason
end
function Helpers.endingHoldAction(prompt,phase,nextPhase)
    if not prompt or not prompt.Parent or not prompt.Enabled then AutoSeq.reason="Waiting for "..phase.." prompt readiness"; return end
    AutoSeq.endingAttempts=AutoSeq.endingAttempts or {}
    local attempts=AutoSeq.endingAttempts[phase] or 0
    if attempts>=2 then AutoSeq.reason="Hold unconfirmed for "..phase.."; automation is paused at this step"; return end
    if os.clock()-(AutoSeq.lastEndingAttempt or -math.huge)<1 then return end
    local ledger=AutoSeq.endingAttempts
    AutoSeq.lastEndingAttempt=os.clock(); ledger[phase]=attempts+1
    local held=Helpers.holdEndingPrompt(prompt,phase)
    if not autoAlive() or AutoSeq.endingPhase~=phase then
        if AutoSeq.endingAttempts==ledger and AutoSeq.endingPhase==phase then ledger[phase]=attempts end
        return
    end
    if held then
        if phase=="soul" then AutoSeq.soulHoldCompleted=true; AutoSeq.soulConfirmed=true
        elseif phase=="give" then AutoSeq.giveHoldCompleted=true; AutoSeq.giveHoldAt=os.clock(); AutoSeq.talkConfirmed=true
        elseif phase=="glove" then AutoSeq.gloveHoldCompleted=true; AutoSeq.gloveAttempted=true; AutoSeq.gloveHoldAt=os.clock() end
        Helpers.advanceEnding(nextPhase,"Completed "..phase.." hold; advancing once")
    else AutoSeq.reason="Hold cancelled or failed for "..phase.."; waiting before retry" end
end

function Helpers.findCorniferGivePrompt()
    local npc=findCornifer()
    if not npc then return nil end
    local cache=Helpers.givePromptCache
    if cache and cache.npc==npc and cache.prompt and cache.prompt.Parent and os.clock()-cache.at<.5 then return cache.prompt end
    local chosen
    for _,instance in ipairs(npc:GetDescendants()) do
        if instance:IsA("ProximityPrompt") then
            local text=(instance.ActionText or ""):lower()
            if text:find("give",1,true) or text:find("deliver",1,true) or text:find("hand over",1,true) then
                if not chosen or instance.Enabled then chosen=instance end
                if instance.Enabled then break end
            end
        end
    end
    chosen=chosen or findNpcTalkPrompt()
    Helpers.givePromptCache={npc=npc,prompt=chosen,at=os.clock()}
    return chosen
end

function Helpers.readGameSnapshot()
    local drop=findDropPrompt()
    local bag,readable,bagSource=Helpers.candyForDrop(drop)
    local round=tonumber(workspace:GetAttribute("Round"))
    local deposited=tonumber(workspace:GetAttribute("DepositedCandy"))
    local npc,anchor=findCornifer()
    local minions=getMinions()
    local near,newNear,incomingNew=0,0,0
    for _,enemy in ipairs(minions) do
        if anchor and enemy.hum.Health>0 then
            local distance=(enemy.pos-anchor.Position).Magnitude
            local new=not (AutoSeq.voteBaseline or {})[enemy.model]
            if distance<=60 then near=near+1; if new then newNear=newNear+1 end end
            if new and distance<=160 then incomingNew=incomingNew+1 end
        end
    end
    local soul,soulOwner=findSoulCandyPrompt()
    local talk=AutoSeq.endingPhase=="give" and Helpers.findCorniferGivePrompt() or findNpcTalkPrompt()
    local glove=findRevenantGlovePrompt()
    local char=LocalPlayer.Character
    local backpack=LocalPlayer:FindFirstChildOfClass("Backpack")
    local owned=(char and char:FindFirstChild("Revenant")) or (backpack and backpack:FindFirstChild("Revenant"))
    local quota=roundQuota(round or 1)
    local decision,reason,target=Helpers.depositDecision(bag,deposited or 0,quota,bagMax())
    local soulConsumed=AutoSeq.soulPrompt and AutoSeq.promptAttempts>0
        and Helpers.promptConsumed(AutoSeq.soulPrompt,AutoSeq.soulOwner) or false
    if not soulConsumed and AutoSeq.soulPrompt and AutoSeq.promptAttempts>0 and AutoSeq.soulWasReady
        and AutoSeq.soulPrompt.Parent and not AutoSeq.soulPrompt.Enabled
        and not AutoSeq.soulTalkWasEnabled and talk and talk.Enabled then soulConsumed=true end
    return {round=round or 1,roundKnown=round~=nil,deposited=deposited or 0,poolKnown=deposited~=nil,
        quota=quota,bag=bag,bagReadable=readable,bagSource=bagSource,capacity=bagMax(),
        shouldDeposit=decision,depositReason=reason,bagTarget=target,
        drop=drop,dropMode=Helpers.dropMode(drop),dropReady=drop and drop.Parent and drop.Enabled or false,
        dropZoneExists=workspace:FindFirstChild("DropZone")~=nil,corniferHP=Helpers.corniferHealth(),
        near=near,newNear=newNear,incomingNew=incomingNew,minions=minions,soul=soul,soulOwner=soulOwner,
        soulReady=soul and soul.Parent and soul.Enabled or false,soulConsumed=soulConsumed,
        talk=talk,talkReady=talk and talk.Parent and talk.Enabled or false,
        glove=glove,gloveReady=glove and glove.Parent and glove.Enabled or false,
        rewardOwned=owned~=nil,dialogueObserved=Helpers.dialogueObserved()}
end
-- Pure stage projection from the current observations plus explicitly timed interaction memory.
function Helpers.deriveStage(g,m,now)
    if g.rewardOwned or (m.gloveAttempted and not g.dropZoneExists) then return "done","Reward/lobby confirmed" end
    if m.endingPhase then
        if g.corniferHP and g.corniferHP<=0 and m.endingPhase~="glove" and m.endingPhase~="exit" then return "failed","Cornifer defeated during ending" end
        local phase=m.endingPhase
        if phase=="preskip" then return "end_skip_before","Skipping dialogue before SoulCandy pickup" end
        if phase=="soul" then return "soulcandy","Collecting SoulCandy with a full stationary hold" end
        if phase=="give" then return "give","Giving SoulCandy to Cornifer with a full hold" end
        if phase=="postskip" then return "end_skip_after","Skipping Cornifer dialogue after giving SoulCandy" end
        if phase=="defend" then
            if g.gloveReady and g.near==0 then return "glove","Final field clear and glove prompt ready" end
            return "defend2",g.near>0 and "Defending Cornifer after SoulCandy delivery" or "Waiting at Cornifer for final enemies/glove"
        end
        if phase=="glove" then return "glove","Collecting the final glove" end
        if phase=="exit" then return "exit","Glove hold finished, waiting for lobby/reward confirmation" end
    end
    if g.gloveReady and (g.round>=3 or m.endingStarted) then return "glove","Glove prompt is ready" end
    if m.gloveAttempted and not g.gloveReady then return "glove","Glove input attempted, waiting for reward or lobby confirmation" end
    if g.soulReady and g.round>=3 then return "soulcandy","SoulCandy prompt is ready" end
    if g.corniferHP and g.corniferHP<=0 then return "failed","Cornifer defeated, waiting for retry" end
    if m.endingStarted or g.round>=4 or m.soulConfirmed then
        if not (m.soulConfirmed or g.soulConsumed or (g.round>=4 and g.talkReady)) then
            return "soulcandy","Waiting for SoulCandy readiness or collection evidence"
        end
        if m.talkConfirmed or g.dialogueObserved then
            if now-(m.dialogueAt or 0)<2.5 then return "talkwait","Dialogue active, waiting for quiet" end
            return "defend2",g.near>0 and "Final enemies near Cornifer" or "Final field clear, waiting for glove readiness"
        end
        return "talk",g.talkReady and "Cornifer talk prompt ready" or "Waiting for talk readiness or dialogue event"
    end
    if not g.roundKnown or not g.poolKnown or not g.bagReadable or not g.dropZoneExists then
        return "sync","Waiting for round, pool, bag and DropZone observations"
    end
    if m.defenseArmedAt and m.defenseArmedRound==g.round then
        local accepted=m.waveAccepted or g.dropMode=="combat"
            or (g.incomingNew or 0)>0 or g.deposited<(m.votePoolBefore or g.deposited)
        if accepted or g.near>0 then return "defend","Protecting Cornifer while the voted wave spawns/approaches" end
        if now-m.defenseArmedAt<8 then return "defend","Vote input sent, preparing at Cornifer for wave spawn" end
        if g.dropReady and g.dropMode=="vote" and g.deposited>=g.quota then
            return "startwave","No wave evidence, Vote prompt ready again; retrying from Cornifer"
        end
        return "defend","Waiting at Cornifer for the game to finish starting the wave"
    end
    local postVote=m.voteFiredAt and now-m.voteFiredAt>=.1 and g.newNear>0
    if g.dropMode=="combat" or (g.near>0 and (m.voteConfirmed or postVote)) then
        return "defend",g.dropMode=="combat" and "DropZone reports combat" or "Post-vote enemies near Cornifer"
    end
    if m.state=="defend" and m.waveRound==g.round and g.near==0 and m.waveIdleSince and now-m.waveIdleSince<3 then
        return "defend","No nearby enemies, allowing a 3-second spawn gap"
    end
    if g.bag>0 then
        if g.dropMode=="vote" then return "sync","Bag and Vote prompt disagree, waiting for candy synchronization" end
        if g.shouldDeposit then
            return "deposit",g.dropReady and g.dropMode=="deposit" and g.depositReason or "Deposit needed, waiting for enabled Deposit mode"
        end
        return "farm",string.format("Candy %d / %d for this trip",g.bag,g.bagTarget)
    end
    if g.deposited<g.quota then
        if m.voteFiredAt and now<(m.voteDeadline or 0) then return "startwave","Vote pending, pool changed while awaiting wave" end
        return "farm","Bag empty and more deposited candy needed"
    end
    if g.dropMode=="deposit" then return "sync","Bag is empty but prompt still says Deposit, waiting for synchronization" end
    return "startwave",g.dropReady and g.dropMode=="vote" and "Bag empty, quota met, Vote prompt ready" or "Quota met, waiting for enabled Vote/Start mode"
end
local function runAutoSequence()
    if not autoAlive() then return end
    local now=os.clock()
    local g=Helpers.readGameSnapshot()
    AutoSeq.snapshot=g
    if not AutoSeq.endingStarted and g.roundKnown then
        if AutoSeq.lastRound and g.round<AutoSeq.lastRound then resetAutoSeq(); activeAutoToken=AutoSeq.generation end
        if AutoSeq.lastRound==nil or g.round~=AutoSeq.lastRound then
            AutoSeq.lastRound=g.round; AutoSeq.waveSeen=false; AutoSeq.waveIdleSince=nil
            AutoSeq.defenseArmedAt=nil; AutoSeq.defenseArmedRound=nil; AutoSeq.waveAccepted=false; AutoSeq.waveRound=nil
            AutoSeq.voteFiredAt=nil; AutoSeq.voteDeadline=nil; AutoSeq.voteBaseline=nil; AutoSeq.voteConfirmed=false
            AutoSeq.startAttempts=0; AutoSeq.emptyHousePasses=0
        end
        AutoSeq.completedWaves=math.clamp(g.round-1,0,3)
    end
    if AutoSeq.state=="defend" and g.near==0 then AutoSeq.waveIdleSince=AutoSeq.waveIdleSince or now
    elseif g.near>0 then AutoSeq.waveIdleSince=nil end
    if g.soulConsumed then AutoSeq.soulConfirmed=true end
    if g.dialogueObserved and AutoSeq.endingStarted then AutoSeq.talkConfirmed=true end
    if AutoSeq.defenseArmedRound==g.round and AutoSeq.defenseArmedAt then
        if g.dropMode=="combat" or (g.incomingNew or 0)>0
            or g.deposited<(AutoSeq.votePoolBefore or g.deposited) then AutoSeq.waveAccepted=true end
    end
    if not AutoSeq.endingPhase and (AutoSeq.endingStarted or g.round>=4 or (g.round>=3 and (g.soulReady or g.gloveReady))) then
        AutoSeq.endingStarted=true; AutoSeq.completedWaves=3
        Helpers.advanceEnding(g.gloveReady and not g.soulReady and "glove" or "preskip","Starting ordered ending sequence")
    end
    local stage,reason=Helpers.deriveStage(g,AutoSeq,now)
    if stage=="done" then stopAuto("Sequence finished",false); return end
    if stage=="soulcandy" or stage=="talk" or stage=="talkwait" or stage=="defend2" or stage=="glove" or stage=="give" or stage=="end_skip_before" or stage=="end_skip_after" or stage=="exit" then
        AutoSeq.endingStarted=true; AutoSeq.completedWaves=3
    end
    if stage=="defend" then
        AutoSeq.waveRound=g.round
        if g.near>0 then AutoSeq.waveSeen=true; AutoSeq.lastEnemyAt=now end
        if AutoSeq.waveAccepted or g.dropMode=="combat" or (AutoSeq.voteFiredAt and g.newNear>0) then AutoSeq.voteConfirmed=true end
    end
    if AutoSeq.state=="defend" and stage~="defend" then AutoSeq.voteConfirmed=false; AutoSeq.waveSeen=false end
    setAutoStage(stage,reason)
    if stage=="sync" then return end
    if stage=="failed" then
        if retryRemote and now-(AutoSeq.retryRequestedAt or -math.huge)>=3 then
            AutoSeq.retryRequestedAt=now; pcall(function() retryRemote:FireServer() end)
        end
        return
    end
    if stage=="farm" then
        -- Recheck the collection threshold before every new house, never halfway into the next reward.
        if g.shouldDeposit and g.bag>0 then return end
        local result=farmOneHouse()
        if not autoAlive() then return end
        if result=="none" then AutoSeq.reason=Helpers.houseWaitReason() end
    elseif stage=="deposit" then
        depositBag()
    elseif stage=="startwave" then
        local confirmed,why=startWave()
        if not autoAlive() then return end
        if confirmed and why~="round changed" then AutoSeq.voteConfirmed=true; AutoSeq.waveAccepted=true end
        if (confirmed or why=="sent, awaiting confirmation") and why~="round changed"
            and AutoSeq.defenseArmedRound==g.round and AutoSeq.defenseArmedAt then
            setAutoStage("defend","Vote input sent, moving to Cornifer to defend")
            defendCornifer()
        end
    elseif stage=="defend" or stage=="defend2" then
        -- Standing at Cornifer during the spawn gap is part of the defense action.
        defendCornifer()
    elseif stage=="end_skip_before" then
        local busy=Helpers.skipEndingDialogue()
        if not busy and now-(AutoSeq.endingPhaseAt or now)>=.5 then Helpers.advanceEnding("soul","Dialogue clear, picking up SoulCandy") end
    elseif stage=="soulcandy" then
        Helpers.endingHoldAction(g.soul,"soul","give")
    elseif stage=="give" then
        if AutoSeq.talkSerial==nil then AutoSeq.talkSerial=AutoSeq.dialogueSerial or 0 end
        Helpers.endingHoldAction(g.talk,"give","postskip")
    elseif stage=="end_skip_after" then
        local busy=Helpers.skipEndingDialogue()
        if g.near>0 then defendCornifer() end
        if not busy and now-math.max(AutoSeq.endingPhaseAt or now,AutoSeq.dialogueAt or 0)>=2.5 then
            Helpers.advanceEnding("defend","Dialogue complete, defending Cornifer")
        end
    elseif stage=="glove" then
        if AutoSeq.endingPhase=="defend" then Helpers.advanceEnding("glove","Final wave finished, moving to glove") end
        Helpers.endingHoldAction(g.glove,"glove","exit")
    elseif stage=="exit" then
        if now-(AutoSeq.gloveHoldAt or now)>=5 and (AutoSeq.endingAttempts.glove or 0)<2 and g.gloveReady then
            Helpers.advanceEnding("glove","Exit not yet confirmed, retrying glove once")
        end
    end
end

