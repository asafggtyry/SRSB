-- Ending interactions hold position for the full prompt duration, then release all temporary controls.
function Helpers.releaseEndingHold()
    local hold=Helpers.endingHold
    if not hold or hold.released then return end
    hold.released=true
    if hold.began then pcall(function() hold.prompt:InputHoldEnd() end) end
    if hold.align then hold.align:Destroy() end
    if hold.attachment then hold.attachment:Destroy() end
    if hold.humanoid and hold.humanoid.Parent then pcall(function() hold.humanoid.AutoRotate=hold.autoRotate end) end
    if hold.cameraRelease then hold.cameraRelease() end
    if Helpers.endingHold==hold then Helpers.endingHold=nil end
end
function Helpers.holdEndingPrompt(prompt,phase)
    local char,hrp,hum=getChar()
    local generation=AutoSeq.generation
    if not char or not hrp or not hum or hum.Health<=0 or not prompt or not prompt.Parent or not prompt.Enabled then return false,"prompt not ready" end
    local position=promptPosition(prompt)
    if not position then return false,"prompt position missing" end
    if releaseCombatHold then releaseCombatHold() end
    Helpers.releaseEndingHold()
    local hold={prompt=prompt,humanoid=hum,autoRotate=hum.AutoRotate,began=false}
    Helpers.endingHold=hold
    local function alive()
        return sg.Parent and not Safety.paused and S.AutoComplete and AutoSeq.generation==generation
            and LocalPlayer.Character==char and hum.Health>0 and AutoSeq.endingPhase==phase and not hold.released
    end
    local ok,result=pcall(function()
        local reach=math.max(.5,prompt.MaxActivationDistance)
        local offset=Vector3.new(hrp.Position.X-position.X,0,hrp.Position.Z-position.Z)
        if offset.Magnitude<.1 then offset=Vector3.new(0,0,1) else offset=offset.Unit end
        offset=offset*math.min(2.5,reach*.4)
        local target=position+offset
        local standing=Helpers.standSpot(target,char,hrp,hum,{},true,true)
        if standing and (standing-position).Magnitude<=reach-.1 then target=standing end
        local relativeOffset=target-position
        moveOnce(prompt,CFrame.lookAt(target,Vector3.new(position.X,target.Y,position.Z)),1)
        hrp.AssemblyLinearVelocity=Vector3.new(0,0,0); hrp.AssemblyAngularVelocity=Vector3.new(0,0,0)
        hum.AutoRotate=false
        hold.attachment=Instance.new("Attachment"); hold.attachment.Name="RevantEndingHoldAttachment"; hold.attachment.Parent=hrp
        hold.align=Instance.new("AlignPosition"); hold.align.Name="RevantEndingHold"
        hold.align.Mode=Enum.PositionAlignmentMode.OneAttachment; hold.align.Attachment0=hold.attachment
        hold.align.MaxForce=1000000; hold.align.Responsiveness=60; hold.align.RigidityEnabled=true
        hold.align.Position=target; hold.align.Parent=hrp
        hold.cameraRelease=facePrompt(prompt)
        task.wait(.1)
        if not alive() then return false end
        local duration=math.max(0,prompt.HoldDuration or 0)+.15
        local native=pcall(function() prompt:InputHoldBegin(); hold.began=true end)
        local untilTime=os.clock()+duration
        while os.clock()<untilTime do
            if not alive() then return false end
            if not prompt.Parent then return true end
            local updated=promptPosition(prompt)
            if updated then hold.align.Position=updated+relativeOffset end
            AutoSeq.reason=string.format("Holding %s: %.1f seconds remaining",phase,math.max(0,untilTime-os.clock()))
            task.wait(.03)
        end
        if not alive() then return false end
        if not native then
            if type(fireproximityprompt)~="function" then return false end
            return pcall(fireproximityprompt,prompt)
        end
        return true
    end)
    Helpers.releaseEndingHold()
    return ok and result==true,ok and "hold finished" or tostring(result)
end
function Helpers.dialogueButtonVisible(button)
    if not button or not button.Parent or not button.Active then return false end
