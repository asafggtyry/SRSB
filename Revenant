local savedSpeed=setmetatable({}, {__mode="k"})
local savedCollisions=setmetatable({}, {__mode="k"})
local function restoreMovement()
    for hum,speed in pairs(savedSpeed) do
        if hum.Parent then hum.WalkSpeed=speed end
        savedSpeed[hum]=nil
    end
    for part,collidable in pairs(savedCollisions) do
        if part.Parent then part.CanCollide=collidable end
        savedCollisions[part]=nil
    end
end
