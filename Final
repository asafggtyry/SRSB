-- Keypad logic
local function updateKeyStatus(text, color)
    keyStatus.Text = text
    if color then keyStatus.TextColor3 = color end
end

local function updateKeyCode(code)
    keyCode.Text = "Code: " .. code
end

local function updateKeyInfo(count)
    keyInfo.Text = "Players: " .. count
end

local function teleportToBackpiece()
    local keypad = workspace:FindFirstChild("Keypad")
    if not keypad then
        updateKeyStatus("Keypad not found!", Color3.fromRGB(255,50,50))
        return false
    end
    local backpiece = keypad:FindFirstChild("Backpiece")
    if not backpiece or not backpiece:IsA("BasePart") then
        updateKeyStatus("Backpiece missing!", Color3.fromRGB(255,50,50))
        return false
    end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = backpiece.CFrame + Vector3.new(0, 3, 0)
    updateKeyStatus("Teleported!", Color3.fromRGB(50,255,50))
    return true
end

local function refreshKeypad()
    local count = Players.NumPlayers
    local codeNumber = (25 * count) + 1093
    updateKeyCode(tostring(codeNumber))
    updateKeyInfo(count)
end

teleportKeypadBtn.MouseButton1Click:Connect(function()
    refreshKeypad()
    teleportToBackpiece()
end)

Players.PlayerAdded:Connect(refreshKeypad)
Players.PlayerRemoving:Connect(refreshKeypad)
refreshKeypad()
updateKeyStatus("Ready - press Teleport")

-- Brazil teleport logic
local function teleportToBrazil()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        brazilStatus.Text = "❌ HumanoidRootPart missing"
        brazilStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    local lobby = workspace:FindFirstChild("Lobby")
    if not lobby then
        brazilStatus.Text = "❌ Workspace.Lobby not found"
        brazilStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    local brazil = lobby:FindFirstChild("brazil")
    if not brazil then
        brazilStatus.Text = "❌ Workspace.Lobby.brazil not found"
        brazilStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    local portal = brazil:FindFirstChild("portal")
    if not portal then
        brazilStatus.Text = "❌ Workspace.Lobby.brazil.portal not found"
        brazilStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    hrp.CFrame = portal.CFrame + Vector3.new(0, 2, 0)
    brazilStatus.Text = "✅ Teleported to Brazil portal!"
    brazilStatus.TextColor3 = Color3.fromRGB(80, 255, 80)
end

