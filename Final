local function buildCounterPage(parent)
    local frame, gloveLbl, _, content = makeHelperPanel(parent, "🥊 Counter Glove Helper (WIP)", {
        gloveName = "Counter",
    })

    local noteLbl = Instance.new("TextLabel")
    noteLbl.Size = UDim2.new(1, 0, 0, 16)
    noteLbl.Position = UDim2.new(0, 0, 0, 0)
    noteLbl.BackgroundTransparency = 1
