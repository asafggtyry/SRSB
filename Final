    local function tpToCFrame(cf)
        local char = LP.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        char:PivotTo(cf)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    local function getHRP()
        local ch = LP.Character
        if not ch then return nil end
        return ch:FindFirstChild("HumanoidRootPart")
    end

    local function walkIntoPart(part)
        if not part or not part.Parent then return end
        local hrp = getHRP()
        if not hrp then return end
        pcall(function()
            if part.CanTouch == false then part.CanTouch = true end
        end)

        local target = part.Position
        local halfHeight = part.Size.Y * 0.3
        local startPos = target + Vector3.new(0, 5 + halfHeight, 0)

        hrp.CFrame = CFrame.new(startPos)
        task.wait(0.12)

        local steps = 20
        for i = 1, steps do
            if not hrp.Parent then return end
            local t = i / steps
            hrp.CFrame = CFrame.new(startPos:Lerp(target, t))
            task.wait(0.04)
        end

        for i = 1, 6 do
            if not hrp.Parent then return end
            hrp.CFrame = CFrame.new(target + Vector3.new(
                (math.random() - 0.5) * 0.6,
                (math.random() - 0.5) * 0.6,
                (math.random() - 0.5) * 0.6
            ))
            task.wait(0.1)
        end

        if hrp.Parent then
            hrp.CFrame = CFrame.new(target + Vector3.new(0, 2.5, 0))
            task.wait(0.1)
            hrp.CFrame = CFrame.new(target)
            task.wait(0.25)
        end
    end

    local function collectGlove(glove)
        if not glove then return false end

        local hardCF = SPECIAL_CFRAMES[glove.name]
        if hardCF then
            tpToCFrame(hardCF)
            task.wait(0.5)
            return true
        end

        if #glove.touchParts == 0 then return false end

        if USE_CF_TP[glove.name] then
            for _, part in ipairs(glove.touchParts) do
                if part and part.Parent then
                    pcall(function()
                        if part.CanTouch == false then part.CanTouch = true end
                    end)
                    tpToCFrame(part.CFrame)
                    task.wait(0.35)
                    local char = LP.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
            return true
        end

        for _, part in ipairs(glove.touchParts) do
            if part and part.Parent then
                walkIntoPart(part)
            end
        end
        return true
    end

