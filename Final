    end

    local function allGlovesCollected()
        for _, name in ipairs(gloveNames) do
            if not isGloveCollected(name) then return false end
        end
        return true
    end

    local function getDigit2()
        if not allGlovesCollected() then return nil, false end
        local adminGloves = DebugRoom:FindFirstChild("AdminGloves")
        if not adminGloves then return nil, false end
        local glovesCode = adminGloves:FindFirstChild("GlovesCode")
        if not glovesCode then return nil, false end
        local surfaceGui = glovesCode:FindFirstChild("SurfaceGui")
        if not surfaceGui then return nil, false end
        local adminNumber = surfaceGui:FindFirstChild("AdminNumber")
        if not adminNumber then return nil, false end
        local digit = adminNumber:GetAttribute("ContentText")
        if digit then
            digit = tonumber(digit)
            if digit then return digit, true end
        end
        if adminNumber:IsA("TextLabel") or adminNumber:IsA("TextButton") then
            local num = tonumber(adminNumber.Text)
            if num then return num, true end
        end
        return nil, false
    end

    local function getDigit3()
        local maze = DebugRoom:FindFirstChild("Maze")
        if not maze then return nil, false end
