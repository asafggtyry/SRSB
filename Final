                    end
                    for _, d in ipairs(entry:GetDescendants()) do
                        if d:IsA("BasePart") and d:FindFirstChild("TouchInterest") then
                            table.insert(parts, d)
                        end
                    end
                    if #parts > 0 then
                        table.sort(parts, function(a, b)
                            local aM = a.Name:lower() == entry.Name:lower()
                            local bM = b.Name:lower() == entry.Name:lower()
                            if aM ~= bM then return aM end
                            return a.Size.Magnitude > b.Size.Magnitude
                        end)
                        local glove = {
                            name = entry.Name,
                            folder = entry,
                            touchParts = parts,
                            mapName = mapFolder.Name,
                        }
                        table.insert(gloves, glove)
                        allGlovesByName[entry.Name] = glove
                    end
                end
                table.sort(gloves, function(a,b) return a.name:lower() < b.name:lower() end)
