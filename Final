local function teleportToBrazil()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        brazilStatus.Text = "❌ HumanoidRootPart missing"
        brazilStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    local lobby = workspace:FindFirstChild("Lobby")
    if not lobby then brazilStatus.Text = "❌ Workspace.Lobby not found"; brazilStatus.TextColor3 = Color3.fromRGB(255,80,80); return end
    local brazil = lobby:FindFirstChild("brazil")
    if not brazil then brazilStatus.Text = "❌ Workspace.Lobby.brazil not found"; brazilStatus.TextColor3 = Color3.fromRGB(255,80,80); return end
    local portal = brazil:FindFirstChild("portal")
    if not portal then brazilStatus.Text = "❌ Workspace.Lobby.brazil.portal not found"; brazilStatus.TextColor3 = Color3.fromRGB(255,80,80); return end
    hrp.CFrame = portal.CFrame + Vector3.new(0, 2, 0)
    brazilStatus.Text = "✅ Teleported to Brazil portal!"
    brazilStatus.TextColor3 = Color3.fromRGB(80, 255, 80)
end
