-- ==================== KEYBIND MANAGEMENT ====================
local activeKeybinds = {}
local eludeMazeStartFunc = nil
local counterLeverFunc = nil
local counterFlyFunc = nil
local counterGloveFunc = nil
local counterHideFunc = nil
local currentWipSub = "Counter"

local function clearKeybinds()
    for _, c in pairs(activeKeybinds) do
        if c then c:Disconnect() end
    end
    activeKeybinds = {}
end

local function setActiveKeybinds(pageName)
    clearKeybinds()

    if pageName == "Elude" then
        table.insert(activeKeybinds, UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.RightControl and eludeMazeStartFunc then
                eludeMazeStartFunc()
            end
        end))
    elseif pageName == "WIP" and currentWipSub == "Counter" then
        table.insert(activeKeybinds, UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.R then
                if counterLeverFunc then counterLeverFunc() end
            elseif input.KeyCode == Enum.KeyCode.H then
                if counterFlyFunc then counterFlyFunc() end
            elseif input.KeyCode == Enum.KeyCode.G then
                if counterGloveFunc then counterGloveFunc() end
            elseif input.KeyCode == Enum.KeyCode.F then
                if counterHideFunc then counterHideFunc() end
            end
        end))
    end
end

local function showSubPage(pageName)
    for name, p in pairs(pages) do
