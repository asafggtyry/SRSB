        local ws = workspace:FindFirstChild("Workspace")
        local lobby = ws and ws:FindFirstChild("Lobby")
        local portal = lobby and lobby:FindFirstChild("Portal" .. n)
        if not portal then
            status("Error", "Missing Workspace.Workspace.Lobby.Portal" .. n, C.err); return
        end
        local pos = portal:IsA("BasePart") and portal.Position
            or (portal.PrimaryPart and portal.PrimaryPart.Position)
        if not pos then status("Error", "Portal has no position", C.err); return end
        local h = hrp()
        if h then h.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end
        status("Success", "Teleported to Portal" .. n .. " — walk in!", C.ok)
    end

    local function tpToButton(n)
        local coords = COORDS[n]
        if not coords then status("Error", "No coords for Challenge " .. n, C.err); return end

        status("TP to Button", ("Moving to (%d, %d, %d)"):format(coords.X, coords.Y, coords.Z), C.blu)
        local h = hrp()
        if h then h.CFrame = CFrame.new(coords + Vector3.new(0, 3, 0)) end
        task.wait(0.7)

        local bestCD, bestDist = nil, 20
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("ClickDetector") and o.Parent and o.Parent:IsA("BasePart") then
                local d = (o.Parent.Position - coords).Magnitude
                if d < bestDist then bestDist = d; bestCD = o end
            end
        end
        if not bestCD then status("Error", "No ClickDetector near coords", C.err); return end

        local part = bestCD.Parent
        status("Found", "Clicking " .. part:GetFullName(), C.ok)

        h = hrp()
        if h then h.CFrame = part.CFrame + Vector3.new(0, 3, 0) end
        task.wait(0.5)

        status("Release Mouse", "Hands off! Clicking in 2s...", C.warn)
        task.wait(2)

        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if not on then status("Warning", "Button off-screen. Aim camera.", C.warn); return end
        local x, y = math.floor(sp.X), math.floor(sp.Y)

        status("Clicking", ("Click at (%d, %d)"):format(x, y), C.acc)
        pcall(function() bestCD.MouseHoverEnter:Fire(LocalPlayer) end)
        task.wait(0.1)
        pcall(function() VIM:SendMouseMoveEvent(x, y, false, false) end)
        task.wait(0.1)
        VIM:SendMouseButtonEvent(x, y, 0, true, false, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, false, 1)
        task.wait(0.1)
        pcall(function() bestCD.MouseHoverLeave:Fire(LocalPlayer) end)

        status("Success", "Challenge " .. n .. " clicked!", C.ok)
    end

