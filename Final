        local total = #collectableParts
        if total == 0 then isMazeRunning = false; return end
        for i, part in ipairs(collectableParts) do
            updateMazeStatus("Part "..i.."/"..total, Color3.fromRGB(255,200,0))
            teleportToPart(part)
            updateMazeInfo(i, total)
            task.wait(1)
        end
        updateMazeStatus("Going to Glove...", Color3.fromRGB(255,200,100))
        local success = teleportToGlove()
        if success then
            updateMazeStatus("Done! ✅", Color3.fromRGB(50,255,50))
        else
            updateMazeStatus("Glove not found", Color3.fromRGB(255,200,0))
        end
