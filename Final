-- ==================== HELPERS ====================
local function addCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function addStroke(parent, transparency)
    local s = Instance.new("UIStroke")
    s.Color = COLORS.border
    s.Thickness = 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

local function teleportToPlace(placeId, statusLabel, pendingText)
    if not placeId or placeId == 0 then
        if statusLabel then
            statusLabel.Text = "❌ Place ID not set"
            statusLabel.TextColor3 = COLORS.red
        end
        return
    end
    if statusLabel then
        statusLabel.Text = pendingText or "⏳ Teleporting..."
        statusLabel.TextColor3 = COLORS.warn
    end
    pcall(function()
        TeleportService:Teleport(placeId, LocalPlayer)
    end)
end

local function ownsGlove(gloveName)
    local folder = LocalPlayer:FindFirstChild("_unlockedGloves")
    if not folder then return nil end
    local bv = folder:FindFirstChild(gloveName)
    if bv and bv:IsA("BoolValue") then return bv.Value end
    return nil
end

local function inPlace(placeId)
    return game.PlaceId == placeId
end

local function makeHelperPanel(parent, title, opts)
    opts = opts or {}

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.96, 0, 0.96, 0)
    frame.Position = UDim2.new(0.02, 0, 0.02, 0)
    frame.BackgroundColor3 = COLORS.panel
    frame.BorderSizePixel = 0
    frame.Parent = parent
    addCorner(frame, 10)
    addStroke(frame, 0.35)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -24, 0, 26)
    titleLbl.Position = UDim2.new(0, 14, 0, 10)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = COLORS.text
    titleLbl.TextSize = 15
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = frame

    local curY = 40

    local gloveStatusLbl = nil
    if opts.gloveName then
        gloveStatusLbl = Instance.new("TextLabel")
        gloveStatusLbl.Size = UDim2.new(1, -28, 0, 18)
        gloveStatusLbl.Position = UDim2.new(0, 14, 0, curY)
        gloveStatusLbl.BackgroundTransparency = 1
        gloveStatusLbl.TextSize = 11
        gloveStatusLbl.Font = Enum.Font.GothamSemibold
        gloveStatusLbl.TextXAlignment = Enum.TextXAlignment.Left
        gloveStatusLbl.Parent = frame

        local has = ownsGlove(opts.gloveName)
        if has == true then
            gloveStatusLbl.Text = "✓ You have this glove"
            gloveStatusLbl.TextColor3 = COLORS.green
        elseif has == false then
            gloveStatusLbl.Text = "✗ You do not have this glove"
            gloveStatusLbl.TextColor3 = COLORS.red
        else
            gloveStatusLbl.Text = "? Glove status unavailable"
            gloveStatusLbl.TextColor3 = COLORS.muted
        end
        curY = curY + 20
    end

    local placeWarnLbl = nil
    if opts.requiredPlace then
        placeWarnLbl = Instance.new("TextLabel")
        placeWarnLbl.Size = UDim2.new(1, -28, 0, 18)
        placeWarnLbl.Position = UDim2.new(0, 14, 0, curY)
        placeWarnLbl.BackgroundTransparency = 1
        placeWarnLbl.TextSize = 11
        placeWarnLbl.Font = Enum.Font.GothamBold
        placeWarnLbl.TextXAlignment = Enum.TextXAlignment.Left
        placeWarnLbl.Parent = frame

        if inPlace(opts.requiredPlace) then
            placeWarnLbl.Text = "✓ At required place"
            placeWarnLbl.TextColor3 = COLORS.green
        else
            placeWarnLbl.Text = "⚠ YOU MUST TP TO PLACE TO GET BADGE"
            placeWarnLbl.TextColor3 = COLORS.warn
        end
        curY = curY + 20
    end

    local contentTop = curY + 6

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -28, 1, -(contentTop + 10))
    content.Position = UDim2.new(0, 14, 0, contentTop)
    content.BackgroundTransparency = 1
    content.Parent = frame

    return frame, gloveStatusLbl, placeWarnLbl, content, contentTop
end

-- ==================== CURSOR UNLOCKER (Alt toggle) ====================
local cursorUnlocked = false
local cursorUnlockLoop = nil

local function unlockCursor()
    if cursorUnlocked then return end
    cursorUnlocked = true
    cursorUnlockLoop = RunService.RenderStepped:Connect(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
end

local function lockCursor()
    if not cursorUnlocked then return end
    cursorUnlocked = false
    if cursorUnlockLoop then
        cursorUnlockLoop:Disconnect()
        cursorUnlockLoop = nil
    end
end

local function toggleCursorUnlock()
    if cursorUnlocked then lockCursor() else unlockCursor() end
end

