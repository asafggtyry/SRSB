    -- Spam left‑click (using VirtualInputManager)
    local function spamLeftClick(duration)
        local success, err = pcall(function()
            local start = tick()
            while tick() - start < duration do
                VIM:SendMouseButtonEvent(0, 0, 0, true, Enum.UserInputType.MouseButton1, 0)
                task.wait(0.05)
                VIM:SendMouseButtonEvent(0, 0, 0, false, Enum.UserInputType.MouseButton1, 0)
                task.wait(0.05)
            end
        end)
        if not success then
            warn("VirtualInputManager not available; trying fallback remotes.")
            local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
            if remotes then
                for i = 1, 10 do
                    local use = remotes:FindFirstChild("Use")
                    if use then use:FireServer() end
                    local slap = remotes:FindFirstChild("Slap")
                    if slap then slap:FireServer() end
                    task.wait(0.1)
                end
            end
        end
    end

