        teleportToPlace(PLACE_IDS.PlatePlace, statusLbl, "⏳ Teleporting to Plate place...")
    end)

    local surviveActive = false
    local clearLoop = nil
    local surviveThread = nil

    local function survive()
        if not inPlace(PLACE_IDS.PlatePlace) then
            statusLbl.Text = "⚠ YOU MUST TP TO PLACE TO GET BADGE"
            statusLbl.TextColor3 = COLORS.warn
            return
        end
        if surviveActive then
            statusLbl.Text = "Already surviving"; return
        end
        local obstaclesFolder = workspace:FindFirstChild("Obstacles")
        if not obstaclesFolder then
            statusLbl.Text = "❌ Obstacles folder missing"; statusLbl.TextColor3 = COLORS.red; return
        end
        surviveActive = true
        statusLbl.Text = "🧹 Clearing obstacles for 120s..."
        statusLbl.TextColor3 = COLORS.green

        clearLoop = RunService.Heartbeat:Connect(function()
            if not surviveActive then clearLoop:Disconnect(); return end
            for _, c in ipairs(obstaclesFolder:GetChildren()) do c:Destroy() end
        end)

        surviveThread = task.spawn(function()
            local remaining = 120
            while remaining > 0 and surviveActive do
                statusLbl.Text = string.format("⏳ %ds remaining (clearing obstacles)", remaining)
                task.wait(1)
                remaining -= 1
            end
            surviveActive = false
            if clearLoop then clearLoop:Disconnect(); clearLoop = nil end
            statusLbl.Text = "🎉 Survival complete! You should have the Plate glove now."
            statusLbl.TextColor3 = COLORS.green
        end)
    end

