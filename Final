local function loadFanHelper(parent)
    local frame, gloveLbl, _, content = makeHelperPanel(parent, "🗺️ Fan Glove Quest Helper", {
        gloveName = "Fan",
    })

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, 0, 0, 20)
    statusLbl.Position = UDim2.new(0, 0, 0, 0)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Ready"
    statusLbl.TextColor3 = COLORS.muted
    statusLbl.TextSize = 12
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = content

    local function setStatus(t, c) statusLbl.Text = t; statusLbl.TextColor3 = c or COLORS.text end
    local function fireRemote(name, times)
        local rf = ReplicatedStorage:FindFirstChild("RemoteEvents")
        local r = rf and rf:FindFirstChild(name)
        if r then
            for _ = 1, (times or 1) do
                pcall(function() r:FireServer() end)
                task.wait(0.5)
            end
            return true
        end
        return false
    end
    local function getPartCFrame(path, waitTime)
        local cur = workspace
        for _, n in ipairs(path) do
            local p = cur:FindFirstChild(n)
            if not p and waitTime then p = cur:WaitForChild(n, waitTime) end
            if not p then return nil end
            cur = p
        end
        if cur:IsA("BasePart") then return cur.CFrame end
        if cur:IsA("Model") then
            local pr = cur.PrimaryPart
            if pr then return pr.CFrame end
            for _, d in ipairs(cur:GetDescendants()) do
                if d:IsA("BasePart") then return d.CFrame end
            end
        end
    end
    local function tpTo(cf)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and cf then hrp.CFrame = cf + Vector3.new(0,3,0); return true end
        return false
    end
    local function startQuest()
        setStatus("Talking to Pablo...", COLORS.blue)
        fireRemote("SuitUpClown", 2)
        task.wait(1)
        fireRemote("KeyQuest", 1)
        task.wait(1)
        setStatus("✅ Quest started.", COLORS.green)
    end
    local function tpAndFire(path, targetName, remoteName, fireTimes, waitTime)
        local cf = getPartCFrame(path, waitTime)
        if not cf then setStatus("❌ Missing: "..targetName, COLORS.red); return end
        if tpTo(cf) then
            task.wait(1)
            fireRemote(remoteName, fireTimes)
            setStatus("✅ "..remoteName.." fired", COLORS.green)
        end
    end

    local yPos = 30
    local function addStep(text, cb)
        makeButton(content, text, yPos, COLORS.sidebarButton, cb)
        yPos = yPos + 44
    end

    addStep("1. Start Quest (Talk to Pablo)", function()
        task.spawn(function() startQuest() end)
    end)
    addStep("2. TP to Key & Acquire", function()
        task.spawn(function()
            tpAndFire({"QuestStuff", "Key"}, "Key", "KeyAcquired", 1, 10)
        end)
    end)
    addStep("3. TP to Cage & Claim Badge", function()
        task.spawn(function()
            tpAndFire({"Buildings", "oog's cage", "Door"}, "Cage", "KeyBadgeReward", 1, 5)
        end)
    end)
    addStep("4. Talk to Pablo Again", function()
        task.spawn(function()
            tpAndFire({"NPCS", "Pablo Pinkypoo"}, "Pablo", "SuitUpClown", 1, 5)
        end)
    end)
    addStep("⚡ AUTO COMPLETE QUEST ⚡", function()
        task.spawn(function()
            setStatus("Auto sequence...", COLORS.purple)
            startQuest()
            tpAndFire({"QuestStuff", "Key"}, "Key", "KeyAcquired", 1, 10)
            tpAndFire({"Buildings", "oog's cage", "Door"}, "Cage", "KeyBadgeReward", 1, 5)
            tpAndFire({"NPCS", "Pablo Pinkypoo"}, "Pablo", "SuitUpClown", 1, 5)
            setStatus("✅ Auto finished!", COLORS.green)
        end)
    end)
end

