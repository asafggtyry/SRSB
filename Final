    local function getTargetCFrame(path, maxWait)
        local current = workspace
        for _, name in ipairs(path) do
            local part = current:FindFirstChild(name)
            if not part and maxWait then
                setStatus("Waiting for "..name.." to spawn...", COLORS.blue)
                part = current:WaitForChild(name, maxWait)
            end
            if not part then
                return nil, "Missing: "..name
            end
            current = part
        end

        if current:IsA("BasePart") then return current.CFrame, nil
        elseif current:IsA("Model") then
            local primary = current.PrimaryPart
            if primary then return primary.CFrame, nil end
            for _, p in ipairs(current:GetDescendants()) do
                if p:IsA("BasePart") then return p.CFrame, nil end
            end
            return nil, "No part in model"
        else return nil, "Not a part or model" end
    end

    local function teleportTo(cframe)
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            setStatus("❌ HumanoidRootPart missing!", COLORS.red)
            return false
        end
        hrp.CFrame = cframe + Vector3.new(0, 3, 0)
        return true
    end

