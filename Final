-- ==================== MAIN TAB SWITCHING ====================
local function showMainPage(pageName)
    homePage.Visible = (pageName == "Home")
    glovesPage.Visible = (pageName == "Gloves")
    wipPage.Visible = (pageName == "WIP")
    for n, b in pairs(navButtons) do
        b.BackgroundColor3 = (n == pageName) and COLORS.sidebarActive or COLORS.sidebarButton
        b.TextColor3 = (n == pageName) and COLORS.text or COLORS.muted
    end
    currentMainPage = pageName
end

for name, b in pairs(navButtons) do
    b.MouseButton1Click:Connect(function() showMainPage(name) end)
end

-- ==================== GLOBAL KEYBINDS ====================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
        toggleCursorUnlock()
        refreshCursorBtn()
        return
    end
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.P then
        toggleCursorUnlock()
        refreshCursorBtn()
    elseif input.KeyCode == Enum.KeyCode.Q then
        toggleMinimize()
    elseif currentMainPage == "Gloves" and currentGlovePage == "Elude" then
        if input.KeyCode == Enum.KeyCode.RightControl and eludeMazeStartFunc then
            eludeMazeStartFunc()
        end
    elseif currentMainPage == "WIP" and currentWipSub == "Counter" then
        if input.KeyCode == Enum.KeyCode.R then
            if counterLeverFunc then counterLeverFunc() end
        elseif input.KeyCode == Enum.KeyCode.H then
            if counterFlyFunc then counterFlyFunc() end
        elseif input.KeyCode == Enum.KeyCode.G then
            if counterGloveFunc then counterGloveFunc() end
        elseif input.KeyCode == Enum.KeyCode.F then
            if counterHideFunc then counterHideFunc() end
        end
    end
end)

refreshCursorBtn()
showMainPage("Home")

print("Helper Hub loaded successfully.")
