        if not mazeNumber then return nil, false end
        local digit = mazeNumber:GetAttribute("ContentText")
        if digit then
            digit = tonumber(digit)
            if digit then return digit, true end
        end
        if mazeNumber:IsA("TextLabel") or mazeNumber:IsA("TextButton") then
            local num = tonumber(mazeNumber.Text)
            if num then return num, true end
        end
        return nil, false
    end

    local function getDigit4() return 7, true end

    local function teleportToGlove(gloveName)
        local uncollected = DebugRoom:FindFirstChild("UncollectedGloves")
        if not uncollected then statusLabel.Text = "UncollectedGloves not found."; return end
        local folder = uncollected:FindFirstChild(gloveName)
        if not folder then statusLabel.Text = gloveName.." already collected."; return end
        local glovePart = folder:FindFirstChildWhichIsA("BasePart")
        if not glovePart then statusLabel.Text = "No part found."; return end
        local hrp = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Torso")
        if not hrp then statusLabel.Text = "Character not ready."; return end
        hrp.CFrame = glovePart.CFrame * CFrame.new(0, 1.5, 3)
