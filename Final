local function buildOperaGXPage(parent)
    local frame, gloveLbl, placeLbl, content = makeHelperPanel(parent, "🎮 Opera GX Helper (WIP)", {
        gloveName = "G-X",
        requiredPlace = PLACE_IDS.OperaGX,
    })

    local wipBanner = Instance.new("TextLabel")
    wipBanner.Size = UDim2.new(1, 0, 0, 18)
    wipBanner.Position = UDim2.new(0, 0, 0, 0)
    wipBanner.BackgroundTransparency = 1
    wipBanner.Text = "⚠️ WIP — ClickDetector clicks may not work"
    wipBanner.TextColor3 = COLORS.warn
    wipBanner.TextSize = 11
    wipBanner.Font = Enum.Font.GothamBold
    wipBanner.TextXAlignment = Enum.TextXAlignment.Left
    wipBanner.Parent = content

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, 0, 0, 18)
    statusLbl.Position = UDim2.new(0, 0, 0, 20)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Ready"
    statusLbl.TextColor3 = COLORS.muted
    statusLbl.TextSize = 11
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = content

    local COORDS = {
        [1] = Vector3.new(142, 86, 926),
        [2] = Vector3.new(-387, 86, 386),
        [3] = Vector3.new(850, 86, 381),
    }

    local function tpToPortal(n)
        local ws = workspace:FindFirstChild("Workspace")
        local lobby = ws and ws:FindFirstChild("Lobby")
        local portal = lobby and lobby:FindFirstChild("Portal"..n)
        if not portal then
            statusLbl.Text = "❌ Missing Portal"..n
            statusLbl.TextColor3 = COLORS.red
            return
        end
        local pos = portal:IsA("BasePart") and portal.Position
            or (portal.PrimaryPart and portal.PrimaryPart.Position)
        if not pos then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end
        statusLbl.Text = "✅ TP'd to Portal"..n
        statusLbl.TextColor3 = COLORS.green
    end

    local function tpToButton(n)
        if not inPlace(PLACE_IDS.OperaGX) then
            statusLbl.Text = "⚠ YOU MUST TP TO PLACE TO GET BADGE"
            statusLbl.TextColor3 = COLORS.warn
            return
        end
        local coords = COORDS[n]
        if not coords then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(coords + Vector3.new(0, 3, 0)) end
        task.wait(0.7)
        local bestCD, bestDist = nil, 20
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("ClickDetector") and o.Parent and o.Parent:IsA("BasePart") then
                local d = (o.Parent.Position - coords).Magnitude
                if d < bestDist then bestDist = d; bestCD = o end
            end
        end
        if not bestCD then
            statusLbl.Text = "❌ No ClickDetector found"
            statusLbl.TextColor3 = COLORS.red
            return
        end
        local part = bestCD.Parent
        if hrp then hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0) end
        task.wait(0.5)
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if not on then
            statusLbl.Text = "⚠ Button off screen"
            statusLbl.TextColor3 = COLORS.warn
            return
        end
        local x, y = math.floor(sp.X), math.floor(sp.Y)
        pcall(function() bestCD.MouseHoverEnter:Fire(LocalPlayer) end)
        task.wait(0.1)
        pcall(function() VIM:SendMouseMoveEvent(x, y, false, false) end)
        task.wait(0.1)
        VIM:SendMouseButtonEvent(x, y, 0, true, false, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, false, 1)
        task.wait(0.1)
        pcall(function() bestCD.MouseHoverLeave:Fire(LocalPlayer) end)
        statusLbl.Text = "✅ Challenge "..n.." clicked"
        statusLbl.TextColor3 = COLORS.green
    end

    -- Utility: TP to OperaGX place
    makeButton(content, "🌐 TP to Opera GX Place", 46, COLORS.purple, function()
        teleportToPlace(PLACE_IDS.OperaGX, statusLbl, "⏳ Teleporting to Opera GX...")
    end)

    -- Challenge 1/2/3 sections
    local y = 90
    for n = 1, 3 do
        makeButton(content, "Challenge "..n.." — TP to Portal"..n, y, COLORS.blue, function()
            tpToPortal(n)
        end)
        y = y + 42
        makeButton(content, "Challenge "..n.." — TP to Button & Click", y, COLORS.green, function()
            tpToButton(n)
        end)
        y = y + 46
    end
end

