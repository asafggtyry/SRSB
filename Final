    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, 0, 0, 20)
    statusLbl.Position = UDim2.new(0, 0, 0, 66)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Ready"
    statusLbl.TextColor3 = COLORS.muted
    statusLbl.TextSize = 12
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = content

    local flyEnabled = false
    local timerThread = nil
    local gloveSpawned = false
    local originalPos = nil

    local function setStatus(t, c) statusLbl.Text = t; statusLbl.TextColor3 = c or COLORS.text end
    local function updateTimer(m, s) timerLbl.Text = string.format("⏱️ Timer: %02d:%02d", m, s) end
    local function tpTo(cf)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        hrp.CFrame = cf + Vector3.new(0, 2, 0)
        return true
    end

    local function setPhysicsFlight(hrp, enable)
        local humanoid = hrp.Parent:FindFirstChildOfClass("Humanoid")
        local floatAtt = hrp:FindFirstChild("FlightAttachment") or Instance.new("Attachment")
        floatAtt.Name = "FlightAttachment"
        floatAtt.Parent = hrp
        local lv = hrp:FindFirstChild("FlightVelocity")
        if enable then
            if humanoid then humanoid.PlatformStand = true end
            if not lv then
                lv = Instance.new("LinearVelocity")
                lv.Name = "FlightVelocity"
                lv.MaxForce = 100000
                lv.VectorVelocity = Vector3.new(0,0,0)
                lv.Attachment0 = floatAtt
                lv.RelativeTo = Enum.ActuatorRelativeTo.World
                lv.Parent = hrp
            end
        else
            if humanoid then humanoid.PlatformStand = false end
            if lv then lv:Destroy() end
            if floatAtt then floatAtt:Destroy() end
        end
    end

    local function stopTimer()
        if timerThread then task.cancel(timerThread); timerThread = nil end
        updateTimer(0,0)
    end

    local function startTimer()
        stopTimer()
        gloveSpawned = false
        timerThread = task.spawn(function()
            local remaining = 180
            while remaining > 0 do
                updateTimer(math.floor(remaining/60), remaining%60)
                task.wait(1)
                remaining -= 1
            end
            gloveSpawned = true
            updateTimer(0,0)
            setStatus("✅ Counter Glove spawned! Press G.", COLORS.green)
            timerThread = nil
        end)
    end

    local function toggleFly(enable)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if enable then
            flyEnabled = true
            originalPos = hrp.CFrame
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 50, 0)
            setPhysicsFlight(hrp, true)
            setStatus("🕊️ Fly ON", Color3.fromRGB(100,255,255))
            startTimer()
        else
            flyEnabled = false
            setPhysicsFlight(hrp, false)
            stopTimer()
            if originalPos then
                hrp.CFrame = originalPos + Vector3.new(0, 2, 0)
                originalPos = nil
            end
            setStatus("🕊️ Fly OFF", COLORS.muted)
        end
    end

    local function findGlovePart()
        local maze = workspace:FindFirstChild("Maze")
        if not maze then return nil end
        for _, o in ipairs(maze:GetDescendants()) do
            if o:IsA("BasePart") and #o:GetChildren() > 0 then return o end
        end
        return nil
    end

    local function actionLever()
        local lever = workspace:FindFirstChild("CounterLever")
        if not lever then setStatus("❌ CounterLever not found", COLORS.red); return end
        local main = lever:FindFirstChild("Main")
        if main and main:IsA("BasePart") then
            tpTo(main.CFrame)
            setStatus("✅ Lever", COLORS.green)
        else
            for _, p in ipairs(lever:GetDescendants()) do
                if p:IsA("BasePart") then
                    tpTo(p.CFrame)
                    setStatus("✅ Lever (fallback)", COLORS.green)
                    return
                end
            end
        end
    end

    local function actionGlove()
        if not gloveSpawned then
            setStatus("❌ Glove hasn't spawned yet", COLORS.warn); return
        end
        local part = findGlovePart()
        if not part then setStatus("❌ No glove part", COLORS.red); return end
        tpTo(part.CFrame)
        setStatus("✅ Teleported", COLORS.green)
    end

    local function actionToggleFly() toggleFly(not flyEnabled) end
    local function actionHide() frame.Visible = not frame.Visible end

    counterLeverFunc = actionLever
    counterFlyFunc = actionToggleFly
    counterGloveFunc = actionGlove
    counterHideFunc = actionHide

    makeButton(content, "🔧 Teleport to Lever [R]", 92, COLORS.sidebarButton, actionLever)
    makeButton(content, "🕊️ Fly (3min timer) [H]", 136, COLORS.sidebarButton, actionToggleFly)
    makeButton(content, "🧤 TP to Glove [G]", 180, COLORS.sidebarButton, actionGlove)

    updateTimer(0,0)
end

