-- Keybind management
local activeKeybinds = {}
local eludeMazeStartFunc = nil
local counterLeverFunc = nil
local counterFlyFunc = nil
local counterGloveFunc = nil
local counterHideFunc = nil

local function setActiveKeybinds(pageName)
    for _, conn in pairs(activeKeybinds) do
        if conn then conn:Disconnect() end
    end
    activeKeybinds = {}

    if pageName == "Elude" then
        local conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == Enum.KeyCode.RightControl then
                if eludeMazeStartFunc then eludeMazeStartFunc() end
            end
        end)
        activeKeybinds[#activeKeybinds+1] = conn
    elseif pageName == "Counter (WIP)" then
        local conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == Enum.KeyCode.R then
                if counterLeverFunc then counterLeverFunc() end
            elseif input.KeyCode == Enum.KeyCode.H then
                if counterFlyFunc then counterFlyFunc() end
            elseif input.KeyCode == Enum.KeyCode.G then
                if counterGloveFunc then counterGloveFunc() end
            elseif input.KeyCode == Enum.KeyCode.F then
                if counterHideFunc then counterHideFunc() end
            end
        end)
        activeKeybinds[#activeKeybinds+1] = conn
    end
    -- Plate and Riftshot have no special keybinds
end

local function showSubPage(pageName)
    debugPage.Visible = (pageName == "Debug")
    eludePage.Visible = (pageName == "Elude")
    boxingPage.Visible = (pageName == "Boxing")
    fanPage.Visible = (pageName == "Fan")
    untitledPage.Visible = (pageName == "Untitled")
    counterPage.Visible = (pageName == "Counter (WIP)")
    platePage.Visible = (pageName == "Plate")
    riftshotPage.Visible = (pageName == "Riftshot")

    for name, btn in pairs(subTabButtons) do
        btn.BackgroundColor3 = (name == pageName) and COLORS.sidebarActive or COLORS.sidebarButton
        btn.TextColor3 = (name == pageName) and COLORS.text or COLORS.muted
    end

    setActiveKeybinds(pageName)
end

