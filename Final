    end

    local function isGloveCollected(gloveName)
        local uncollected = DebugRoom:FindFirstChild("UncollectedGloves")
        if not uncollected then return true end
        return not uncollected:FindFirstChild(gloveName)
    end

    local function allGlovesCollected()
        for _, name in ipairs(gloveNames) do
            if not isGloveCollected(name) then return false end
        end
        return true
    end

    local function getDigit2()
        if not allGlovesCollected() then return nil, false end
        local adminGloves = DebugRoom:FindFirstChild("AdminGloves")
        if not adminGloves then return nil, false end
        local glovesCode = adminGloves:FindFirstChild("GlovesCode")
        if not glovesCode then return nil, false end
        local surfaceGui = glovesCode:FindFirstChild("SurfaceGui")
        if not surfaceGui then return nil, false end
        local adminNumber = surfaceGui:FindFirstChild("AdminNumber")
        if not adminNumber then return nil, false end
        local digit = adminNumber:GetAttribute("ContentText")
        if digit then
            digit = tonumber(digit)
            if digit then return digit, true end
        end
        if adminNumber:IsA("TextLabel") or adminNumber:IsA("TextButton") then
            local num = tonumber(adminNumber.Text)
            if num then return num, true end
        end
        return nil, false
    end

    local function getDigit3()
        local maze = DebugRoom:FindFirstChild("Maze")
        if not maze then return nil, false end
        local prize = maze:FindFirstChild("MazePrize")
        if not prize then return nil, false end
        local surfaceGui = prize:FindFirstChild("SurfaceGui")
        if not surfaceGui then return nil, false end
        local mazeNumber = surfaceGui:FindFirstChild("MazeNumber")
        if not mazeNumber then return nil, false end
        local digit = mazeNumber:GetAttribute("ContentText")
        if digit then
            digit = tonumber(digit)
            if digit then return digit, true end
        end
        if mazeNumber:IsA("TextLabel") or mazeNumber:IsA("TextButton") then
            local num = tonumber(mazeNumber.Text)
            if num then return num, true end
        end
        return nil, false
    end

    local function getDigit4() return 7, true end

    local function teleportToGlove(gloveName)
        local uncollected = DebugRoom:FindFirstChild("UncollectedGloves")
        if not uncollected then statusLabel.Text = "UncollectedGloves not found."; return end
        local folder = uncollected:FindFirstChild(gloveName)
        if not folder then statusLabel.Text = gloveName.." already collected."; return end
        local glovePart = folder:FindFirstChildWhichIsA("BasePart")
        if not glovePart then statusLabel.Text = "No part found."; return end
        local hrp = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Torso")
        if not hrp then statusLabel.Text = "Character not ready."; return end
        hrp.CFrame = glovePart.CFrame * CFrame.new(0, 1.5, 3)
        statusLabel.Text = "Teleported to "..gloveName
    end

    for name, btn in pairs(gloveButtons) do
        btn.MouseButton1Click:Connect(function() teleportToGlove(name) end)
    end

    tpKeypad.MouseButton1Click:Connect(function()
