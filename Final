    local function updateMazeStatus(text, color)
        mazeStatus.Text = text
        if color then mazeStatus.TextColor3 = color end
    end
    local function updateMazeInfo(found, total)
        mazeInfo.Text = "Collectables: "..found.." found"
        mazeProgress.Text = "Progress: "..found.."/"..total
    end
    local function scanCollectables()
        collectableFolder = workspace:FindFirstChild("Collectable")
        if not collectableFolder then updateMazeStatus("Folder not found!", Color3.fromRGB(255,50,50)); return false end
        local parts = {}
        for _, child in ipairs(collectableFolder:GetChildren()) do
            if child:IsA("BasePart") then table.insert(parts, child) end
        end
        collectableParts = parts
        updateMazeInfo(0, #parts)
        if #parts == 0 then updateMazeStatus("No parts!", Color3.fromRGB(255,200,0)); return false end
        updateMazeStatus("Ready", Color3.fromRGB(50,255,50))
        return true
    end

    local function teleportToPart(part)
        local char = LocalPlayer.Character
        if not char then return false end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return false end
        root.CFrame = part.CFrame + Vector3.new(0,2,0)
        return true
    end

    local function teleportToGlove()
        local ruins = workspace:FindFirstChild("ruins")
        if not ruins then updateMazeStatus("ruins not found", Color3.fromRGB(255,50,50)); return false end
        local elude = ruins:FindFirstChild("Elude")
        if not elude then updateMazeStatus("Elude not found", Color3.fromRGB(255,50,50)); return false end
        local glovePart = elude:FindFirstChild("Glove")
        if not glovePart or not glovePart:IsA("BasePart") then updateMazeStatus("Glove part not found", Color3.fromRGB(255,50,50)); return false end
        local char = LocalPlayer.Character
        if not char then return false end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return false end
        root.CFrame = glovePart.CFrame + Vector3.new(0,2,0)
        updateMazeStatus("Teleported to Glove! ✅", Color3.fromRGB(50,255,50))
        return true
    end

    local function runMaze()
        if isMazeRunning then return end
        isMazeRunning = true
        mazeBtn.Text = "⏳ Running..."
        scanCollectables()
        local total = #collectableParts
        if total == 0 then isMazeRunning = false; return end
        for i, part in ipairs(collectableParts) do
            updateMazeStatus("Part "..i.."/"..total, Color3.fromRGB(255,200,0))
            teleportToPart(part)
            updateMazeInfo(i, total)
            task.wait(1)
        end
        updateMazeStatus("Going to Glove...", Color3.fromRGB(255,200,100))
        local success = teleportToGlove()
        if success then
            updateMazeStatus("Done! ✅", Color3.fromRGB(50,255,50))
        else
            updateMazeStatus("Glove not found", Color3.fromRGB(255,200,0))
        end
        mazeBtn.Text = "Start Maze"
        isMazeRunning = false
    end

    local function startMaze()
        if isMazeRunning then return end
        scanCollectables()
        if #collectableParts > 0 then
            task.spawn(runMaze)
        end
    end

    mazeBtn.MouseButton1Click:Connect(startMaze)
    gloveBtn.MouseButton1Click:Connect(teleportToGlove)

    -- Keybind for Right Control
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.RightControl then
            startMaze()
        end
    end)

    scanCollectables()
    task.wait(0.5)
    teleportToGlove() -- update status only
end

