        mazeInfo.Text = "Collectables: "..found.." found"
        mazeProgress.Text = "Progress: "..found.."/"..total
    end
    local function scanCollectables()
        collectableFolder = workspace:FindFirstChild("Collectable")
        if not collectableFolder then updateMazeStatus("Folder not found!", Color3.fromRGB(255,50,50)); return false end
        local parts = {}
        for _, child in ipairs(collectableFolder:GetChildren()) do
            if child:IsA("BasePart") then table.insert(parts, child) end
        end
        collectableParts = parts
        updateMazeInfo(0, #parts)
        if #parts == 0 then updateMazeStatus("No parts!", Color3.fromRGB(255,200,0)); return false end
        updateMazeStatus("Ready", Color3.fromRGB(50,255,50))
        return true
    end

