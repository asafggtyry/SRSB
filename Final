local function teleportToBackpiece()
    local keypad = workspace:FindFirstChild("Keypad")
    if not keypad then return false end
    local backpiece = keypad:FindFirstChild("Backpiece")
    if not backpiece or not backpiece:IsA("BasePart") then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = backpiece.CFrame + Vector3.new(0,3,0)
    return true
end

local function refreshKeypad()
    local count = Players.NumPlayers
    keyCode.Text = "Code: "..tostring((25 * count) + 1093)
    keyInfo.Text = "Players: "..count
end

