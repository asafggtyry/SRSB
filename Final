        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Sign" then
                sign = obj
                break
            end
        end
        if not sign then
            setStatus("❌ Sign not found! Can't slap.", Color3.fromRGB(255, 80, 80))
            return
        end
        setStatus("🚶 Moving near Sign...", Color3.fromRGB(200, 200, 100))
        teleportTo(sign.CFrame)
        task.wait(0.3)
        setStatus("✋ Spamming left‑click to slap...", Color3.fromRGB(255, 200, 100))
        spamLeftClick(1.5)
        setStatus("✅ Slapped the Sign! Now use Survive.", Color3.fromRGB(80, 255, 80))
    end

    -- 3. Survive: clear obstacles for 2 minutes
    local surviveActive = false
    local clearLoop = nil
    local surviveThread = nil

    local function survive()
        if surviveActive then
            setStatus("⚠️ Already in survival mode.", Color3.fromRGB(255, 200, 0))
            return
        end

        local obstaclesFolder = workspace:FindFirstChild("Obstacles")
        if not obstaclesFolder then
            setStatus("❌ No 'Obstacles' folder found! Can't clear obstacles.", Color3.fromRGB(255, 80, 80))
            return
        end

        setStatus("🧹 Clearing all obstacles...", Color3.fromRGB(200, 200, 255))
        surviveActive = true
        local duration = 120

        -- Continuously delete children
        clearLoop = RunService.Heartbeat:Connect(function()
            if not surviveActive then
                clearLoop:Disconnect()
                return
            end
            for _, child in ipairs(obstaclesFolder:GetChildren()) do
                child:Destroy()
            end
        end)

        setStatus("🛡️ Surviving for 120 seconds (obstacles cleared constantly)", Color3.fromRGB(255, 255, 100))
        setTimer("⏳ 120s remaining")

        surviveThread = task.spawn(function()
            local remaining = duration
            while remaining > 0 and surviveActive do
                setTimer(string.format("⏳ %d seconds remaining", remaining))
                task.wait(1)
                remaining -= 1
            end
            -- Clean up
            surviveActive = false
            if clearLoop then clearLoop:Disconnect(); clearLoop = nil end
            setTimer("✅ Survival complete!")
            setStatus("🎉 You should have the Plate glove and badge now!", Color3.fromRGB(80, 255, 80))
            surviveThread = nil
        end)
    end

