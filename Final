    local function setPhysicsFlight(hrp, enable)
        local humanoid = hrp.Parent:FindFirstChildOfClass("Humanoid")
        local floatAtt = hrp:FindFirstChild("FlightAttachment") or Instance.new("Attachment")
        floatAtt.Name = "FlightAttachment"
        floatAtt.Parent = hrp

        local linearVelocity = hrp:FindFirstChild("FlightVelocity")

        if enable then
            if humanoid then humanoid.PlatformStand = true end
            if not linearVelocity then
                linearVelocity = Instance.new("LinearVelocity")
                linearVelocity.Name = "FlightVelocity"
                linearVelocity.MaxForce = 100000
                linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                linearVelocity.Attachment0 = floatAtt
                linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
                linearVelocity.Parent = hrp
            end
        else
            if humanoid then humanoid.PlatformStand = false end
            if linearVelocity then linearVelocity:Destroy() end
            if floatAtt then floatAtt:Destroy() end
        end
    end

    local function stopTimer()
        if timerThread then task.cancel(timerThread); timerThread = nil end
        updateTimerDisplay(0,0)
    end

    local function startTimer()
        stopTimer()
        gloveSpawned = false
        timerThread = task.spawn(function()
            local remaining = 180
            while remaining > 0 do
                updateTimerDisplay(math.floor(remaining/60), remaining%60)
                task.wait(1)
                remaining -= 1
            end
            gloveSpawned = true
            updateTimerDisplay(0,0)
            setStatus("✅ Counter Glove spawned! Press G to teleport.", Color3.fromRGB(80,255,80))
            timerThread = nil
        end)
    end

    local function toggleFly(enable)
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if enable then
            flyEnabled = true
            originalPos = hrp.CFrame
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 50, 0)
            setPhysicsFlight(hrp, true)
            setStatus("🕊️ Fly ON (Hovering 50 studs up)", Color3.fromRGB(100,255,255))
            startTimer()
        else
            flyEnabled = false
            setPhysicsFlight(hrp, false)
            stopTimer()
            if originalPos then
