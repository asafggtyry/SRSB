        local success = teleportTo(cframe)
        if success then
            setStatus("✅ Teleported to "..targetName..". Firing remote...", COLORS.green)
            task.wait(1)
            if fireRemote(remoteName, fireTimes) then
                setStatus("✅ Fired "..remoteName.."!", COLORS.green)
                return true
            else
