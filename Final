        local ruins = workspace:FindFirstChild("ruins")
        if not ruins then updateMazeStatus("ruins not found", Color3.fromRGB(255,50,50)); return false end
        local elude = ruins:FindFirstChild("Elude")
        if not elude then updateMazeStatus("Elude not found", Color3.fromRGB(255,50,50)); return false end
        local glovePart = elude:FindFirstChild("Glove")
        if not glovePart or not glovePart:IsA("BasePart") then updateMazeStatus("Glove part not found", Color3.fromRGB(255,50,50)); return false end
        local char = LocalPlayer.Character
        if not char then return false end
        local root = char:FindFirstChild("HumanoidRootPart")
