    btn.Parent = parent
    addCorner(btn, 7)
    addStroke(btn, 0.65)

    btn.MouseEnter:Connect(function()
        if btn.BackgroundColor3 ~= COLORS.sidebarActive then
            btn.BackgroundColor3 = COLORS.buttonHover
            btn.TextColor3 = COLORS.text
