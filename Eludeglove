-- ============================================================
-- 3. ELUDE MAZE + GLOVE LOGIC
-- ============================================================
local collectableFolder = nil
local collectableParts = {}
local isMazeRunning = false

local function updateMazeStatus(text, color)
    mazeStatus.Text = text
    if color then mazeStatus.TextColor3 = color end
end

local function updateMazeInfo(found, total)
    mazeInfo.Text = "Collectables: " .. found .. " found"
    mazeProgress.Text = "Progress: " .. found .. "/" .. total
end

local function scanCollectables()
    collectableFolder = Workspace:FindFirstChild("Collectable")
    if not collectableFolder then
        updateMazeStatus("Collectable folder not found!", Color3.fromRGB(255, 50, 50))
        mazeBtn.Text = "❌ Not Found"
        mazeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        return false
    end
    local parts = {}
    for _, child in ipairs(collectableFolder:GetChildren()) do
        if child:IsA("BasePart") then
            table.insert(parts, child)
        end
    end
    collectableParts = parts
    local total = #parts
    updateMazeInfo(0, total)
    if total == 0 then
        updateMazeStatus("No parts found in Collectable!", Color3.fromRGB(255, 200, 0))
        mazeBtn.Text = "⚠️ No Parts"
        mazeBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 0)
        return false
    end
    updateMazeStatus("Ready – press Start or Right Ctrl", Color3.fromRGB(50, 255, 50))
    mazeBtn.Text = "▶ Start Maze"
    mazeBtn.BackgroundColor3 = Color3.fromRGB(60, 80, 180)
    return true
end

local function teleportToPart(part)
    local character = player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = part.CFrame + Vector3.new(0, 2, 0)
    return true
end

-- === GLOVE TELEPORT ===
local function teleportToGlove()
    local ruins = Workspace:FindFirstChild("ruins")
    if not ruins then
        gloveStatus.Text = "ruins not found"
        gloveStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
        gloveBtn.Text = "❌ No ruins"
        gloveBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        return false
    end
    local elude = ruins:FindFirstChild("Elude")
    if not elude then
        gloveStatus.Text = "Elude not found in ruins"
        gloveStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
        gloveBtn.Text = "❌ No Elude"
        gloveBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        return false
    end
    local glovePart = elude:FindFirstChild("Glove")
    if not glovePart or not glovePart:IsA("BasePart") then
        gloveStatus.Text = "Glove part not found"
        gloveStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
        gloveBtn.Text = "❌ No Glove"
        gloveBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        return false
    end
    local character = player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = glovePart.CFrame + Vector3.new(0, 2, 0)
    gloveStatus.Text = "Teleported to Glove! ✅"
    gloveStatus.TextColor3 = Color3.fromRGB(50, 255, 50)
    gloveBtn.Text = "✔ Done"
    gloveBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
    return true
end

-- Maze run (now includes glove at the end)
local function runMaze()
    if isMazeRunning then return end
    isMazeRunning = true
    mazeBtn.Text = "⏳ Running..."
    mazeBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    updateMazeStatus("Starting...", Color3.fromRGB(255, 200, 0))

    scanCollectables()
    local total = #collectableParts
    if total == 0 then
        updateMazeStatus("No parts to visit!", Color3.fromRGB(255, 50, 50))
        isMazeRunning = false
        mazeBtn.Text = "▶ Start Maze"
        mazeBtn.BackgroundColor3 = Color3.fromRGB(60, 80, 180)
        return
    end

    -- Visit each collectable part
    for i, part in ipairs(collectableParts) do
        if not part or not part:IsA("BasePart") then break end
        updateMazeStatus("Teleporting to " .. part.Name .. " (" .. i .. "/" .. total .. ")", Color3.fromRGB(255, 200, 0))
        teleportToPart(part)
        updateMazeInfo(i, total)
        task.wait(1)
    end

    -- FINAL: teleport to Glove
    updateMazeStatus("Teleporting to Glove (final)...", Color3.fromRGB(255, 200, 100))
    local success = teleportToGlove()
    if success then
        updateMazeStatus("All done! (Glove reached) ✅", Color3.fromRGB(50, 255, 50))
        mazeBtn.Text = "✔ Done"
        mazeBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
    else
        updateMazeStatus("Glove not found – maze partial", Color3.fromRGB(255, 200, 0))
        mazeBtn.Text = "⚠️ No Glove"
        mazeBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 0)
    end

    isMazeRunning = false
end

-- Start maze function (called by button or keybind)
local function startMaze()
    if isMazeRunning then
        updateMazeStatus("Already running!", Color3.fromRGB(255, 200, 0))
        return
    end
    scanCollectables()
    if #collectableParts > 0 then
        task.spawn(runMaze)
    else
        updateMazeStatus("No parts – scan again", Color3.fromRGB(255, 200, 0))
    end
end

-- Maze button click
mazeBtn.MouseButton1Click:Connect(startMaze)

-- Glove button click
gloveBtn.MouseButton1Click:Connect(teleportToGlove)

-- Keybind: Right Control starts maze
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        startMaze()
    end
end)

