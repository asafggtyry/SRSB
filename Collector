    local function stroke(o, col)
        local s = Instance.new("UIStroke"); s.Color = col or C.brd; s.Thickness = 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = o; return s
    end

    local function tpToCFrame(cf)
        local char = LP.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        char:PivotTo(cf)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    local function getHRP()
        local ch = LP.Character
        if not ch then return nil end
        return ch:FindFirstChild("HumanoidRootPart")
    end

    local function walkIntoPart(part)
        if not part or not part.Parent then return end
        local hrp = getHRP()
        if not hrp then return end
        pcall(function()
            if part.CanTouch == false then part.CanTouch = true end
        end)

        local target = part.Position
        local halfHeight = part.Size.Y * 0.3
        local startPos = target + Vector3.new(0, 5 + halfHeight, 0)

        hrp.CFrame = CFrame.new(startPos)
        task.wait(0.12)

        local steps = 20
        for i = 1, steps do
            if not hrp.Parent then return end
            local t = i / steps
            hrp.CFrame = CFrame.new(startPos:Lerp(target, t))
            task.wait(0.04)
        end

        for i = 1, 6 do
            if not hrp.Parent then return end
            hrp.CFrame = CFrame.new(target + Vector3.new(
                (math.random() - 0.5) * 0.6,
                (math.random() - 0.5) * 0.6,
                (math.random() - 0.5) * 0.6
            ))
            task.wait(0.1)
        end

        if hrp.Parent then
            hrp.CFrame = CFrame.new(target + Vector3.new(0, 2.5, 0))
            task.wait(0.1)
            hrp.CFrame = CFrame.new(target)
            task.wait(0.25)
        end
    end

    local function collectGlove(glove)
        if not glove then return false end

        local hardCF = SPECIAL_CFRAMES[glove.name]
        if hardCF then
            tpToCFrame(hardCF)
            task.wait(0.5)
            return true
        end

        if #glove.touchParts == 0 then return false end

        if USE_CF_TP[glove.name] then
            for _, part in ipairs(glove.touchParts) do
                if part and part.Parent then
                    pcall(function()
                        if part.CanTouch == false then part.CanTouch = true end
                    end)
                    tpToCFrame(part.CFrame)
                    task.wait(0.35)
                    local char = LP.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
            return true
        end

        for _, part in ipairs(glove.touchParts) do
            if part and part.Parent then
                walkIntoPart(part)
            end
        end
        return true
    end

    local gloveData = {}
    local allGlovesByName = {}

    local function scanMaps()
        gloveData = {}
        allGlovesByName = {}
        if not root then return end
        for _, mapFolder in ipairs(root:GetChildren()) do
            if mapFolder:IsA("Model") or mapFolder:IsA("Folder") then
                local gloves = {}
                for _, entry in ipairs(mapFolder:GetChildren()) do
                    local parts = {}
                    if entry:IsA("BasePart") and entry:FindFirstChild("TouchInterest") then
                        table.insert(parts, entry)
                    end
                    for _, d in ipairs(entry:GetDescendants()) do
                        if d:IsA("BasePart") and d:FindFirstChild("TouchInterest") then
                            table.insert(parts, d)
                        end
                    end
                    if #parts > 0 then
                        table.sort(parts, function(a, b)
                            local aM = a.Name:lower() == entry.Name:lower()
                            local bM = b.Name:lower() == entry.Name:lower()
                            if aM ~= bM then return aM end
                            return a.Size.Magnitude > b.Size.Magnitude
                        end)
                        local glove = {
                            name = entry.Name,
                            folder = entry,
                            touchParts = parts,
                            mapName = mapFolder.Name,
                        }
                        table.insert(gloves, glove)
                        allGlovesByName[entry.Name] = glove
                    end
                end
                table.sort(gloves, function(a,b) return a.name:lower() < b.name:lower() end)
                gloveData[mapFolder.Name] = gloves
            end
        end
    end

    if isInMinigame then scanMaps() end

