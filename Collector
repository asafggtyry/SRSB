    round(scroll,10); stroke(scroll,C.brd)

    local busy = false
    local autoWatchOn = false
    local autoWatchThread = nil
    local collected = {}

    local function rebuildSidebar()
        for _, c in ipairs(sideScroll:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end

        local query = searchBox.Text:lower()
        local names = {}
        for _, n in ipairs(ALL_GLOVES) do
            if query == "" or n:lower():find(query, 1, true) then
                table.insert(names, n)
            end
        end
        table.sort(names, function(a,b)
            local aP = pinned[a] and 1 or 0
            local bP = pinned[b] and 1 or 0
            if aP ~= bP then return aP > bP end
            return a:lower() < b:lower()
        end)

        local order = 0
        for _, name in ipairs(names) do
            order = order + 1
            local glove = allGlovesByName[name]
            local isSpawned = glove ~= nil and #glove.touchParts > 0
            local hasHardCF = SPECIAL_CFRAMES[name] ~= nil
            local isCFGlove = USE_CF_TP[name] == true
            local isPinned = pinned[name] == true
            local isQuest = QUEST_GLOVES[name] == true
            local wasCollected = collected[name] == true

            local rowBg = C.surfAlt
            if wasCollected then rowBg = Color3.fromRGB(30,45,30)
            elseif isPinned then rowBg = Color3.fromRGB(60,45,25)
            elseif hasHardCF then rowBg = Color3.fromRGB(30,50,60)
            elseif isCFGlove and isSpawned then rowBg = Color3.fromRGB(50,40,55)
            elseif isSpawned then rowBg = Color3.fromRGB(30,50,35) end

            local row = mk("Frame",{
                Size=UDim2.new(1,0,0,24), BackgroundColor3=rowBg,
                BorderSizePixel=0, LayoutOrder=order,
            }, sideScroll)
            round(row,4)

            local pinBtn = mk("TextButton",{
                Size=UDim2.new(0,20,1,0), BackgroundTransparency=1,
                Text=isPinned and "★" or "☆",
                TextColor3=isPinned and C.gold or C.dim,
                TextSize=13, Font=Enum.Font.GothamBold,
            }, row)
            pinBtn.MouseButton1Click:Connect(function()
                pinned[name] = not pinned[name]
                rebuildSidebar()
            end)

            local dotColor = C.dim
            if wasCollected then dotColor = C.gold
            elseif hasHardCF then dotColor = C.blu
            elseif isCFGlove and isSpawned then dotColor = C.pur
            elseif isSpawned then dotColor = C.ok
            elseif isQuest then dotColor = C.warn end

            mk("Frame",{
                Size=UDim2.new(0,6,0,6), Position=UDim2.new(0,22,0.5,-3),
                BackgroundColor3=dotColor, BorderSizePixel=0,
            }, row)

            local label = name
            if wasCollected then
                label = name .. "  ✓"
            elseif hasHardCF then
                label = name .. "  (CF)"
            elseif isCFGlove then
                label = name .. "  (cf-tp)"
            elseif not isSpawned then
                label = name .. (isQuest and "  (quest)" or "  (not here)")
            end

            local nameBtn = mk("TextButton",{
                Size=UDim2.new(1,-30,1,0), Position=UDim2.new(0,30,0,0),
                BackgroundTransparency=1, Text=label,
                TextColor3=C.text,
                TextSize=10, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left,
            }, row)
            nameBtn.MouseButton1Click:Connect(function()
                if hasHardCF then
                    setStatus("TP (CF): " .. name, C.blu)
                    task.spawn(function()
                        tpToCFrame(SPECIAL_CFRAMES[name])
                        task.wait(0.5)
                        collected[name] = true
                        rebuildSidebar()
                        setStatus(name .. " teleported", C.ok)
                    end)
                    return
                end
                if not isSpawned then
                    setStatus(name .. " not in GloveLocation", C.warn)
                    return
                end
                setStatus("TP: " .. name, C.blu)
                task.spawn(function()
                    collectGlove(glove)
                    collected[name] = true
                    rebuildSidebar()
                    setStatus(name .. " teleported", C.ok)
                end)
            end)
        end
    end

    local function rebuildMain()
        for _, c in ipairs(scroll:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end

        scanMaps()

        if not scroll:FindFirstChildOfClass("UIListLayout") then
            mk("UIListLayout",{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder},scroll)
        end
        if not scroll:FindFirstChildOfClass("UIPadding") then
            mk("UIPadding",{
                PaddingTop=UDim.new(0,8), PaddingBottom=UDim.new(0,8),
                PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8),
            },scroll)
        end

        local order = 0
        local totalSpawned = 0

        order = order + 1
        local specialSection = mk("Frame",{
            Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1, LayoutOrder=order,
        }, scroll)
        mk("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder}, specialSection)
        local specialHeader = mk("Frame",{
            Size=UDim2.new(1,0,0,28), BackgroundColor3=Color3.fromRGB(35,45,60),
            BorderSizePixel=0,
        }, specialSection)
        round(specialHeader,8)
        mk("TextLabel",{
            Size=UDim2.new(1,-20,0,20), Position=UDim2.new(0,10,0.5,-10),
            BackgroundTransparency=1, Text="HARDCODED CFrame (not in map)",
            TextColor3=C.blu, TextSize=12, Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, specialHeader)

        for name, cf in pairs(SPECIAL_CFRAMES) do
            local row = mk("Frame",{
                Size=UDim2.new(1,-8,0,26), BackgroundColor3=C.surfAlt,
                BorderSizePixel=0, LayoutOrder=2,
            }, specialSection)
            round(row,5)
            mk("TextLabel",{
                Size=UDim2.new(1,-70,1,0), Position=UDim2.new(0,10,0,0),
                BackgroundTransparency=1, Text=name .. "  (CF)",
                TextColor3=C.text, TextSize=11, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left,
            }, row)
            mk("TextLabel",{
                Size=UDim2.new(0,60,1,0), Position=UDim2.new(1,-66,0,0),
                BackgroundTransparency=1, Text="GET",
                TextColor3=C.blu, TextSize=10, Font=Enum.Font.GothamBold,
                TextXAlignment=Enum.TextXAlignment.Right,
            }, row)
            local btn = mk("TextButton",{
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="",
            }, row)
            btn.MouseButton1Click:Connect(function()
                setStatus("GET (CF): " .. name, C.blu)
                task.spawn(function()
                    tpToCFrame(cf)
                    task.wait(0.5)
                    collected[name] = true
                    rebuildSidebar()
                    setStatus(name .. " teleported", C.ok)
                end)
            end)
        end

        local sortedMaps = {}
        for name in pairs(gloveData) do table.insert(sortedMaps, name) end
        table.sort(sortedMaps)

        for _, mapName in ipairs(sortedMaps) do
            local gloves = gloveData[mapName]
            if #gloves > 0 then
                totalSpawned = totalSpawned + #gloves
                order = order + 1
                local section = mk("Frame",{
                    Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                    BackgroundTransparency=1, LayoutOrder=order,
                }, scroll)
                mk("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder}, section)

                local header = mk("Frame",{
                    Size=UDim2.new(1,0,0,32), BackgroundColor3=C.panel, BorderSizePixel=0,
                }, section)
                round(header,8)
                mk("Frame",{
                    Size=UDim2.new(0,3,0,16), Position=UDim2.new(0,6,0.5,-8),
                    BackgroundColor3=C.blu, BorderSizePixel=0,
                }, header)
                mk("TextLabel",{
                    Size=UDim2.new(1,-20,0,20), Position=UDim2.new(0,18,0.5,-10),
                    BackgroundTransparency=1, Text=mapName .. "  (" .. #gloves .. ")",
                    TextColor3=C.text, TextSize=12, Font=Enum.Font.GothamBold,
                    TextXAlignment=Enum.TextXAlignment.Left,
                }, header)

                local body = mk("Frame",{
                    Size=UDim2.new(1,-8,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                    Position=UDim2.new(0,8,0,0), BackgroundTransparency=1,
                    LayoutOrder=2,
                }, section)
                mk("UIListLayout",{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder}, body)

                for i, glove in ipairs(gloves) do
                    local r = mk("Frame",{
                        Size=UDim2.new(1,0,0,26), BackgroundColor3=C.surfAlt,
                        BorderSizePixel=0, LayoutOrder=i,
                    }, body)
                    round(r,5)

                    local method = USE_CF_TP[glove.name] and "cf" or "walk"
                    local mc = USE_CF_TP[glove.name] and C.pur or C.ok

                    mk("Frame",{
                        Size=UDim2.new(0,3,0,14), Position=UDim2.new(0,6,0.5,-7),
                        BackgroundColor3=mc, BorderSizePixel=0,
                    }, r)

                    mk("TextLabel",{
                        Size=UDim2.new(1,-90,1,0), Position=UDim2.new(0,16,0,0),
                        BackgroundTransparency=1, Text=glove.name,
                        TextColor3=C.text, TextSize=11, Font=Enum.Font.Gotham,
                        TextXAlignment=Enum.TextXAlignment.Left,
                    }, r)
                    mk("TextLabel",{
                        Size=UDim2.new(0,70,1,0), Position=UDim2.new(1,-76,0,0),
                        BackgroundTransparency=1,
                        Text=("["..#glove.touchParts.."] "..method),
                        TextColor3=mc, TextSize=9, Font=Enum.Font.Code,
                        TextXAlignment=Enum.TextXAlignment.Right,
                    }, r)
                    local btn = mk("TextButton",{
                        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="",
                    }, r)
                    btn.MouseButton1Click:Connect(function()
                        setStatus("GET: " .. glove.name, C.blu)
                        task.spawn(function()
                            collectGlove(glove)
                            collected[glove.name] = true
                            rebuildSidebar()
                            setStatus(glove.name .. " teleported", C.ok)
                        end)
                    end)
                end
            end
        end

        return totalSpawned
    end

    collectAllBtn.MouseButton1Click:Connect(function()
        if busy then setStatus("Already running...", C.warn); return end
        busy = true
        task.spawn(function()
            for name, cf in pairs(SPECIAL_CFRAMES) do
                setStatus("GET (CF): " .. name, C.blu)
                tpToCFrame(cf)
                task.wait(0.5)
                collected[name] = true
            end

            local total, done = 0, 0
            for _, gloves in pairs(gloveData) do total = total + #gloves end
            for mapName, gloves in pairs(gloveData) do
                for _, g in ipairs(gloves) do
                    done = done + 1
                    setStatus(("... %s %d/%d - %s"):format(mapName, done, total, g.name), C.blu)
                    collectGlove(g)
                    collected[g.name] = true
                    task.wait(0.2)
                end
            end
            rebuildSidebar()
            setStatus(("DONE! %d gloves"):format(total), C.ok)
            busy = false
        end)
    end)

    local function stopAutoWatch()
        autoWatchOn = false
        if autoWatchThread then task.cancel(autoWatchThread); autoWatchThread = nil end
        autoWatchBtn.BackgroundColor3 = C.surfAlt
        autoWatchBtn.Text = "▶ AUTO-WATCH"
        setStatus("Auto-watch stopped", C.warn)
    end

    local function startAutoWatch()
        autoWatchOn = true
        autoWatchBtn.BackgroundColor3 = C.ok
        autoWatchBtn.Text = "● AUTO-WATCH"
        setStatus("Auto-watch running", C.ok)
        autoWatchThread = task.spawn(function()
            while autoWatchOn do
                scanMaps()
                local toCollect = {}
                for name, glove in pairs(allGlovesByName) do
                    if not collected[name] and #glove.touchParts > 0 then
                        table.insert(toCollect, glove)
                    end
                end
                if #toCollect > 0 and not busy then
                    busy = true
                    for _, g in ipairs(toCollect) do
                        if not autoWatchOn then break end
                        setStatus(("AUTO: %s"):format(g.name), C.blu)
                        collectGlove(g)
                        collected[g.name] = true
                        task.wait(0.3)
                    end
                    busy = false
                    rebuildSidebar()
                end
                rebuildSidebar()
                task.wait(3)
            end
        end)
    end

    autoWatchBtn.MouseButton1Click:Connect(function()
        if autoWatchOn then stopAutoWatch() else startAutoWatch() end
    end)

    rescanBtn.MouseButton1Click:Connect(function()
        if busy then setStatus("Busy", C.warn); return end
        local n = rebuildMain()
        rebuildSidebar()
        setStatus(("Rescanned — %d spawned"):format(n), C.ok)
    end)

    searchBox:GetPropertyChangedSignal("Text"):Connect(rebuildSidebar)

    local n = rebuildMain()
    rebuildSidebar()
    setStatus(("Ready — %d spawned"):format(n), C.ok)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.X then gui:Destroy() end
        if input.KeyCode == Enum.KeyCode.R and not busy then
            local nn = rebuildMain()
            rebuildSidebar()
            setStatus(("Rescanned — %d spawned"):format(nn), C.ok)
        end
    end)
end

