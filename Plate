-- ============ BUTTON BUILDER ============
local function makeButton(text, y, color, onClick)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(1, -28, 0, 40)
    b.Position         = UDim2.new(0, 14, 0, y)
    b.BackgroundColor3 = color or COLORS.button
    b.AutoButtonColor  = false
    b.Text             = text
    b.TextColor3       = COLORS.text
    b.TextSize         = 12
    b.Font             = Enum.Font.GothamSemibold
    b.BorderSizePixel  = 0
    b.Parent           = innerPanel
    addCorner(b, 6)
    addStroke(b, 0.4)
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = COLORS.buttonHover
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = color or COLORS.button
    end)
    b.MouseButton1Click:Connect(onClick)
    return b
end

-- ============ SURVIVE STATE (forward-declared for closeBtn) ============
local surviveActive = false
local clearLoop     = nil
local surviveBtn    -- forward-declared so we can flip its label
local timerLbl      -- countdown display

local function stopSurvive(reason, color)
    surviveActive = false
    if clearLoop then clearLoop:Disconnect(); clearLoop = nil end
    if surviveBtn then
        surviveBtn.Text             = "🧹 Survive (clear obstacles for 2 min)"
        surviveBtn.BackgroundColor3 = COLORS.button
    end
    if reason then setStatus(reason, color or COLORS.muted) end
end

local function survive()
    if not inPlace(PLATE_PLACE_ID) then
        setStatus("⚠ YOU MUST TP TO PLACE TO GET BADGE", COLORS.warn)
        return
    end
    if surviveActive then
        setStatus("Already surviving — press button to stop", COLORS.warn)
        return
    end

    local obstaclesFolder = workspace:FindFirstChild(OBSTACLES_NAME)
    if not obstaclesFolder then
        setStatus("❌ Obstacles folder missing", COLORS.red)
        return
    end

    surviveActive = true
    surviveBtn.Text             = "■ Stop Surviving"
    surviveBtn.BackgroundColor3 = COLORS.danger
    setStatus("🧹 Clearing obstacles for " .. SURVIVE_TIME .. "s...", COLORS.green)

    -- Continuous clearing loop
    clearLoop = RunService.Heartbeat:Connect(function()
        if not surviveActive then
            if clearLoop then clearLoop:Disconnect(); clearLoop = nil end
            return
        end
        local folder = workspace:FindFirstChild(OBSTACLES_NAME)
        if folder then
            for _, c in ipairs(folder:GetChildren()) do
                pcall(function() c:Destroy() end)
            end
        end
    end)

    -- Countdown
    task.spawn(function()
        local remaining = SURVIVE_TIME
        while remaining > 0 and surviveActive do
            setStatus(string.format("⏳ %ds remaining (clearing obstacles)", remaining), COLORS.warn)
            task.wait(1)
            remaining -= 1
        end
        if surviveActive then
            stopSurvive("🎉 Survival complete! Check your gloves.", COLORS.green)
        end
    end)
end

