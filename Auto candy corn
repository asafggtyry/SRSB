-- === Visual helpers ===
local function corner(p, r)
    local o = Instance.new("UICorner"); o.CornerRadius = UDim.new(0, r or 20); o.Parent = p
end
local function stroke(p, t)
    local o = Instance.new("UIStroke"); o.Color = C.border; o.Transparency = t or .76
    o.Thickness = 1; o.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; o.Parent = p; return o
end
local function frame(p, x, y, w, h, color, transparency, r)
    local o = Instance.new("Frame"); o.Position = UDim2.fromOffset(x, y); o.Size = UDim2.fromOffset(w, h)
    o.BackgroundColor3 = color or C.panel; o.BackgroundTransparency = transparency or 0
    o.BorderSizePixel = 0; o.Parent = p; if r then corner(o, r) end; return o
end
local function text(p, value, x, y, w, h, size, color, font)
    local o = Instance.new("TextLabel"); o.Position = UDim2.fromOffset(x, y); o.Size = UDim2.fromOffset(w, h)
    o.BackgroundTransparency = 1; o.Text = value; o.TextColor3 = color or C.text
    o.TextSize = size or 14; o.Font = font or Enum.Font.Gotham; o.TextXAlignment = Enum.TextXAlignment.Left
    o.TextTruncate = Enum.TextTruncate.AtEnd; o.Parent = p; return o
end
local function button(p, value, x, y, w, h, filled)
    local o = Instance.new("TextButton"); o.Position = UDim2.fromOffset(x, y); o.Size = UDim2.fromOffset(w, h)
    o.BackgroundColor3 = filled and C.purple or C.panel; o.BackgroundTransparency = filled and .02 or .68
    o.Text = value; o.TextColor3 = filled and ink or C.text; o.TextSize = 13; o.Font = Enum.Font.GothamMedium
    o.BorderSizePixel = 0; o.AutoButtonColor = false; o.Parent = p; corner(o, h/2); stroke(o, filled and .9 or .5)
    o.MouseEnter:Connect(function()
        TweenService:Create(o, TweenInfo.new(.16), { BackgroundTransparency = filled and 0 or .4 }):Play()
    end)
    o.MouseLeave:Connect(function()
        TweenService:Create(o, TweenInfo.new(.16), { BackgroundTransparency = filled and .02 or .68 }):Play()
    end)
    return o
end
local function sheen(p, amount)
    local g = Instance.new("UIGradient"); g.Rotation = 75
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, amount or .38) })
    g.Parent = p
end

-- === Config ===
local CANDY_FOLDER_NAME  = "CandyCorns"
local ARENA_NAME         = "Arena"
local ISLAND_NAME        = "island5"
local SLAPPLE_FOLDER_NAME= "Slapples"
local GLOVE_NAME         = "Glove"
local FARM_INTERVAL      = 0.2

local LOBBY_NAME         = "Lobby"
local PORTAL_NAME        = "Teleport1"
local PORTAL_WAIT        = 1.0     -- ← changed from 0.5 to 1.0

local MAX_PAGES          = 5
local EARLY_EXIT_PLAYERS = 5

-- === State ===
local States = { FarmCandy = true, FarmSlapple = true }
local Auto = { canceled = false }

-- === Helpers ===
local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function findSlappleFolder()
    local arena = workspace:FindFirstChild(ARENA_NAME)
    if not arena then return nil end
    local island = arena:FindFirstChild(ISLAND_NAME)
    if not island then return nil end
    return island:FindFirstChild(SLAPPLE_FOLDER_NAME)
end
local function findAllPartsByName(container, name)
    local results = {}
    if not container then return results end
    local function search(inst)
        for _, child in ipairs(inst:GetChildren()) do
            if child:IsA("BasePart") and child.Name == name then
                table.insert(results, child)
            end
            if child:IsA("Folder") or child:IsA("Model") then search(child) end
        end
    end
    pcall(search, container)
    return results
end

-- === Farm pull loop (runs from script load) ===
task.spawn(function()
    while true do
        if not (States.FarmCandy or States.FarmSlapple) then
            task.wait(0.1)
        else
            local hrp = getHRP()
            if hrp then
                if States.FarmCandy then
                    local cf = workspace:FindFirstChild(CANDY_FOLDER_NAME)
                    if cf then
                        for _, c in pairs(cf:GetChildren()) do
                            if c.Parent and c:IsA("BasePart") then
                                pcall(function() c.CFrame = hrp.CFrame end)
                            end
                        end
                    end
                end
                if States.FarmSlapple then
                    local sf = findSlappleFolder()
                    if sf then
                        for _, g in ipairs(findAllPartsByName(sf, GLOVE_NAME)) do
                            if g.Parent then
                                pcall(function() g.CFrame = hrp.CFrame end)
                            end
                        end
                    end
                end
            end
            task.wait(FARM_INTERVAL)
        end
    end
end)

-- === Server scan ===
local function fetchOnePage(cursor)
    if not requestFunc then return nil end
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    if cursor and cursor ~= "" then url = url .. "&cursor=" .. cursor end
    local ok, response = pcall(requestFunc, { Url = url, Method = "GET" })
    if not ok or not response then return nil end
    local body = response.Body or response.body
    if not body then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok2 or not data or not data.data then return nil end
    return data
end

local function scanForLowServer()
    if not requestFunc then return {} end
    local servers, cursor = {}, nil
    local currentJob = game.JobId
    for _ = 1, MAX_PAGES do
        local data = fetchOnePage(cursor)
        if not data then break end
        for _, s in ipairs(data.data) do
            if s.id ~= currentJob and s.playing < s.maxPlayers and s.playing > 0 then
                table.insert(servers, s)
            end
        end
        local foundLow = false
        for _, s in ipairs(servers) do
            if s.playing <= EARLY_EXIT_PLAYERS then foundLow = true; break end
        end
        if foundLow then break end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
        task.wait(0.05)
    end
    return servers
end

