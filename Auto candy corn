local function makeFarmCard(x, title, key, desc)
    local card = frame(body, x, 112, 236, 148, Color3.fromRGB(62,62,58), .55, 20); stroke(card, .9)
    text(card, title, 16, 14, 200, 22, 15, C.text, Enum.Font.GothamMedium)
