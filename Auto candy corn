local function doHop(server)
    local ok = pcall(function()
        local opts = Instance.new("TeleportOptions")
        opts.ServerInstanceId = server.id
        TeleportService:TeleportAsync(game.PlaceId, { LocalPlayer }, opts)
    end)
    if not ok then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
        end)
    end
end

-- === Auto sequence ===
task.spawn(function()
    if not LocalPlayer.Character then LocalPlayer.CharacterAdded:Wait() end
    pcall(function() LocalPlayer.Character:WaitForChild("HumanoidRootPart", 10) end)
    if Auto.canceled then return end

    refreshFarmUI()

    -- 1) TP to portal ONCE
    setStatus("Teleporting to portal...")
    local lobby  = workspace:FindFirstChild(LOBBY_NAME)
    local portal = lobby and lobby:FindFirstChild(PORTAL_NAME)
    local hrp    = getHRP()
    if portal and portal:IsA("BasePart") and hrp and hrp.Parent then
        pcall(function() hrp.CFrame = portal.CFrame + Vector3.new(0, 3, 0) end)
    else
        setStatus("Portal not found — proceeding anyway...")
    end
    if Auto.canceled then return end

    -- 2) 1-second wait for portal
    task.wait(PORTAL_WAIT)
    if Auto.canceled then return end

    -- 3) Scan + hop
    if not requestFunc then
        setStatus("No request function — cannot hop.")
        return
    end

    setStatus(string.format("Scanning (≤%d players, %d pages)...",
        EARLY_EXIT_PLAYERS, MAX_PAGES))
    local servers = scanForLowServer()
    if Auto.canceled then return end

    if #servers == 0 then
        setStatus("No servers found — fallback hop...")
        task.wait(0.3)
        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        return
    end

    table.sort(servers, function(a, b) return a.playing < b.playing end)
    local lowest = servers[1]

    setStatus(string.format(
        "Auto-hopping → %d/%d  (lowest of %d scanned)",
        lowest.playing, lowest.maxPlayers, #servers
    ))
    task.wait(0.3)
    if Auto.canceled then return end
    doHop(lowest)
end)

-- === Q = stop all ===
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        if States.FarmCandy or States.FarmSlapple then
            Auto.canceled = true
            States.FarmCandy = false
            States.FarmSlapple = false
            refreshFarmUI()
            setStatus("Stopped via Q")
        end
    end
end)

-- === Drag ===
local drag, ds, sp, dragInput
local function onWindow(point)
    local over = false
    for _, obj in ipairs(PlayerGui:GetGuiObjectsAtPosition(point.X, point.Y)) do
        if obj:IsDescendantOf(mf) then
            over = true
            local node = obj
            while node and node ~= mf do
                if node:IsA("GuiButton") or node:IsA("TextBox") or node:IsA("ScrollingFrame") then return false end
                node = node.Parent
            end
        end
    end
    return over
end
UserInputService.InputBegan:Connect(function(input)
    if drag or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then return end
    if not sg.Parent or not onWindow(input.Position) then return end
    drag = true; ds = input.Position; sp = mf.Position; dragInput = input
end)
UserInputService.InputChanged:Connect(function(input)
    if not drag then return end
    if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local d = input.Position - ds
    mf.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
end)
UserInputService.InputEnded:Connect(function(input)
    if input == dragInput then drag = false; dragInput = nil end
end)

