            status.Text = "OFF"; status.TextColor3 = C.muted
            card.BackgroundColor3 = Color3.fromRGB(62,62,58); card.BackgroundTransparency = .55
            fill.Size = UDim2.fromScale(0, 1)
        end
    end
    click.MouseButton1Click:Connect(function()
        States[key] = not States[key]; refresh()
    end)
    refresh()
    farmRefreshers[key] = refresh
