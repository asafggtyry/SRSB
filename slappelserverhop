--[[
    Auto Glove Teleporter + Smart Server Hop (Slap Battles)
    - Teleports to Teleport1 → island5
    - Teleports to every Glove part inside Slapples
    - After all existing Gloves are visited, waits 2s then auto‑hops to a new server
    - GUI reappears automatically in the new server
]]

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer

-- ===== CONFIGURATION =====
local LOBBY_NAME = "Lobby"
local TELEPORT_PART_NAME = "Teleport1"
local ARENA_NAME = "Arena"
local ISLAND_NAME = "island5"
local SLAPPLE_FOLDER_NAME = "Slapples"
local TARGET_PART_NAME = "Glove"

local TELEPORT_OFFSET = Vector3.new(0, 3, 0)
local PORTAL_WAIT_TIME = 2.5
local AUTO_HOP_DELAY = 2   -- seconds to wait after visiting all gloves before hopping

-- ===== STATE =====
local isRunning = false
local visitedParts = {}
local loopThread = nil

-- ===== CLEAN UP OLD GUI =====
