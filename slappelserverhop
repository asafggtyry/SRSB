-- ===== HELPERS =====
local function getCharacterRoot()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function teleportToPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local root = getCharacterRoot()
    if not root then return false end
    root.CFrame = part.CFrame + TELEPORT_OFFSET
    return true
end

-- Recursive search for BaseParts with a given name
local function findAllPartsByName(container, name)
    local results = {}
    local function search(instance)
        for _, child in ipairs(instance:GetChildren()) do
            if child:IsA("BasePart") and child.Name == name then
                table.insert(results, child)
            end
            if child:IsA("Folder") or child:IsA("Model") then
                search(child)
            end
        end
    end
    search(container)
    return results
end

-- ===== SERVER HOP =====
local function serverHop()
    if isRunning then
        isRunning = false
        statusLabel.Text = "Stopping & hopping..."
        task.wait(0.5)
    end

    statusLabel.Text = "Searching for servers..."
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    local cursor = ""
    local candidateServers = {}

    while true do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
            placeId,
            cursor ~= "" and ("&cursor=" .. cursor) or ""
        )

        local success, response = pcall(function()
            return game:HttpGet(url)
        end)

        if success and response then
            local data = HttpService:JSONDecode(response)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.id ~= currentJobId 
                       and server.playing < server.maxPlayers 
                       and server.playing > 0 then
                        table.insert(candidateServers, server)
                    end
                end
                if #candidateServers >= 5 or not data.nextPageCursor then
                    break
                else
                    cursor = data.nextPageCursor
                end
            else
                break
            end
        else
            break
        end
    end

    if #candidateServers > 0 then
        statusLabel.Text = "Hopping to new server..."
        local chosenServer = candidateServers[math.random(1, #candidateServers)]
        TeleportService:TeleportToPlaceInstance(placeId, chosenServer.id, player)
    else
        statusLabel.Text = "Fallback hopping..."
        TeleportService:Teleport(placeId, player)
    end
end

-- ===== MAIN LOOP (now auto‑hops when done) =====
local function runLoop()
    -- Step 1: Teleport to Teleport1 in Lobby
    local lobby = workspace:FindFirstChild(LOBBY_NAME)
    if not lobby then
        statusLabel.Text = "Error: Lobby not found!"
        isRunning = false
        return
    end

    local teleportPart = lobby:FindFirstChild(TELEPORT_PART_NAME)
    if not teleportPart or not teleportPart:IsA("BasePart") then
        statusLabel.Text = "Error: Teleport1 not found!"
        isRunning = false
        return
    end

    statusLabel.Text = "Going to Teleport1..."
    teleportToPart(teleportPart)
    task.wait(PORTAL_WAIT_TIME)

    -- Step 2: Find Arena > island5 > Slapples
    local arena = workspace:FindFirstChild(ARENA_NAME)
    if not arena then
        statusLabel.Text = "Error: Arena not found!"
        isRunning = false
        return
    end

    local island = arena:FindFirstChild(ISLAND_NAME)
    if not island then
        statusLabel.Text = "Error: island5 not found in Arena!"
        isRunning = false
        return
    end

    local slappleFolder = island:FindFirstChild(SLAPPLE_FOLDER_NAME)
    if not slappleFolder or not slappleFolder:IsA("Folder") then
        statusLabel.Text = "Error: Slapples folder not found!"
        isRunning = false
        return
    end

    statusLabel.Text = "Scanning for Gloves..."
    visitedParts = {}

    -- Step 3: Collect all current Gloves and teleport to each
    local gloves = findAllPartsByName(slappleFolder, TARGET_PART_NAME)
    if #gloves == 0 then
        statusLabel.Text = "No Gloves found. Auto‑hopping..."
        task.wait(1)
        serverHop()
        return
    end

    statusLabel.Text = "Found " .. #gloves .. " Glove(s). Teleporting..."
    for _, part in ipairs(gloves) do
        if not isRunning then break end
        if not visitedParts[part] then
            visitedParts[part] = true
            statusLabel.Text = "Teleporting to: " .. part.Name
            teleportToPart(part)
            task.wait(0.3)
        end
    end

    -- Step 4: Wait a moment for any late‑spawning Gloves, then auto‑hop
    if isRunning then
        statusLabel.Text = "All visited. Waiting " .. AUTO_HOP_DELAY .. "s for new Gloves..."
        task.wait(AUTO_HOP_DELAY)

        -- One final quick scan to catch any new ones that spawned during the wait
        local newGloves = findAllPartsByName(slappleFolder, TARGET_PART_NAME)
        for _, part in ipairs(newGloves) do
            if not isRunning then break end
            if not visitedParts[part] then
                visitedParts[part] = true
                statusLabel.Text = "Teleporting to late spawn: " .. part.Name
                teleportToPart(part)
                task.wait(0.3)
            end
        end

        -- Auto‑hop if still running
        if isRunning then
            statusLabel.Text = "Auto‑hopping to next server..."
            task.wait(0.5)
            serverHop()
        end
    end
end

-- ===== BUTTON EVENTS =====
startButton.MouseButton1Click:Connect(function()
    if isRunning then
        statusLabel.Text = "Already running"
        return
    end

    isRunning = true
    statusLabel.Text = "Starting..."
    loopThread = task.spawn(runLoop)
end)

stopButton.MouseButton1Click:Connect(function()
    if not isRunning then
        statusLabel.Text = "Not running"
        return
    end
    isRunning = false
    statusLabel.Text = "Stopped"
end)

hopButton.MouseButton1Click:Connect(serverHop)

-- Cleanup if GUI is removed
frame.AncestryChanged:Connect(function()
    if not frame.Parent then
        isRunning = false
    end
end)
