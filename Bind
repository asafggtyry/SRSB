-- ============ AUTO-UNLOCK ON FIRST-PERSON DETECTION ============
-- If the game forces first-person while the helper is open, keep the mouse free.
-- (Only fires while cursorUnlocked is true; the RenderStepped loop also re-applies it.)
task.spawn(function()
    while screenGui.Parent do
        task.wait(1)
        if cursorUnlocked then
            local ok, inFirstPerson = pcall(function()
                return UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default
                    and LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson
            end)
            if ok and inFirstPerson then
                -- Already being handled by the RenderStepped loop, but refresh UI
                refreshCursorStatus()
            end
        end
    end
end)

