-- ============ HELPERS ============
local function addCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function addStroke(parent, transparency)
    local s = Instance.new("UIStroke")
    s.Color        = COLORS.border
    s.Thickness    = 1
    s.Transparency = transparency or 0
    s.Parent       = parent
    return s
end

-- ============ CURSOR UNLOCKER ============
-- Bug note: after wiping ReplicatedStorage the game often forces first-person
-- and re-locks the mouse. We keep re-applying Default behavior every frame while
-- unlocked, so it survives those forced changes.
local cursorUnlocked   = false
local cursorUnlockLoop = nil

local function unlockCursor()
    if cursorUnlocked then return end
    cursorUnlocked   = true
    cursorUnlockLoop = RunService.RenderStepped:Connect(function()
        -- Force Default EVERY frame — fight the game's first-person lock
        UserInputService.MouseBehavior    = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
end

local function lockCursor()
    if not cursorUnlocked then return end
    cursorUnlocked = false
    if cursorUnlockLoop then
        cursorUnlockLoop:Disconnect()
        cursorUnlockLoop = nil
    end
    -- Let the game reclaim control
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end

local function toggleCursorUnlock()
    if cursorUnlocked then lockCursor() else unlockCursor() end
    if BindGui_refreshCursorBtn then BindGui_refreshCursorBtn() end
end

