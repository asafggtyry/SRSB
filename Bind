local function makeButton(text, y, color, onClick)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(1, -28, 0, 36)
    b.Position         = UDim2.new(0, 14, 0, y)
    b.BackgroundColor3 = color or COLORS.button
    b.AutoButtonColor  = false
    b.Text             = text
    b.TextColor3       = COLORS.text
    b.TextSize         = 12
    b.Font             = Enum.Font.GothamSemibold
    b.BorderSizePixel  = 0
    b.Parent           = innerPanel
    addCorner(b, 6)
    addStroke(b, 0.4)
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = COLORS.buttonHover
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = color or COLORS.button
    end)
    b.MouseButton1Click:Connect(onClick)
    return b
end

-- ============ BIND ACTIONS ============
local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function bringOrb()
    local orb = workspace:FindFirstChild("Orb")
    if not orb then return false, "Orb not found" end
    local hrp = getHRP()
    if not hrp then return false, "Character not loaded" end

    if orb:IsA("BasePart") then
        orb.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * 3) + Vector3.new(0, 1, 0)
        return true, "Orb moved"
    elseif orb:IsA("Model") then
        local primary = orb.PrimaryPart
        if not primary then
            for _, d in ipairs(orb:GetDescendants()) do
                if d:IsA("BasePart") then primary = d; break end
            end
        end
        if not primary then return false, "Orb model has no BasePart" end
        local targetPos = hrp.Position + (hrp.CFrame.LookVector * 3) + Vector3.new(0, 1, 0)
        orb:PivotTo(CFrame.new(targetPos))
        return true, "Orb moved"
    else
        return false, "Orb is not a part or model"
    end
end

local function wipeAll()
    setStatus("🧹 Wiping...", COLORS.blue)

    -- Force cursor unlock BEFORE the wipe — this is when the game
    -- slams into first-person and re-locks the mouse.
    unlockCursor()
    refreshCursorBtn()
    refreshCursorStatus()

    local rsCount = 0
    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        pcall(function() child:Destroy() end)
        rsCount += 1
    end

    local shadowCount = 0
    local shadow = workspace:FindFirstChild("Shadow")
    if shadow then
        for _, child in ipairs(shadow:GetChildren()) do
            pcall(function() child:Destroy() end)
            shadowCount += 1
        end
    end

    setStatus("🧲 Bringing Orb...", COLORS.blue)
    local ok, msg = bringOrb()

    if ok then
        setStatus(("✅ Wiped %d RS + %d Shadow. Orb brought."):format(rsCount, shadowCount), COLORS.green)
    else
        setStatus(("✅ Wiped %d RS + %d Shadow. ⚠ Orb: %s"):format(rsCount, shadowCount, msg), COLORS.warn)
    end
end

local function doTeleport()
    setStatus("⏳ Teleporting...", COLORS.warn)
    local ok, err = pcall(function()
        TeleportService:Teleport(BIND_PLACE_ID, LocalPlayer)
    end)
    if not ok then
        setStatus("❌ Teleport failed: " .. tostring(err), COLORS.red)
    end
end

