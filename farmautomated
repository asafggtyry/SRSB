local function openPlayerPage(targetPlayer)
    selectedPlayer = targetPlayer
    NameLabel.Text = targetPlayer.DisplayName .. "\n(@" .. targetPlayer.Name .. ")"
    AvatarImage.Image = "rbxthumb://type=AvatarHeadShot&id=" .. targetPlayer.UserId .. "&w=150&h=150"
    TargetPage.Visible = true
end

local function refreshPlayerList()
    for _, child in ipairs(ListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local PlayerRow = Instance.new("TextButton")
            PlayerRow.Size = UDim2.new(1, -12, 0, 38)
            PlayerRow.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
            PlayerRow.Text = " " .. player.DisplayName
            PlayerRow.TextColor3 = Color3.fromRGB(210, 210, 220)
            PlayerRow.TextSize = 11
            PlayerRow.Font = Enum.Font.Gotham
            PlayerRow.TextXAlignment = Enum.TextXAlignment.Left
            PlayerRow.Parent = ListScroll
            
            local rowCorner = Instance.new("UICorner")
            rowCorner.CornerRadius = UDim.new(0, 6)
            rowCorner.Parent = PlayerRow
            
            PlayerRow.MouseButton1Click:Connect(function() openPlayerPage(player) end)
        end
    end
end

