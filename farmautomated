-- Player Interaction Executions
TeleportBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Character and LocalPlayer.Character then
        local tRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local mRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot and mRoot then mRoot.CFrame = tRoot.CFrame * CFrame.new(0, 3, 0) end
    end
end)

SlapBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Character and LocalPlayer.Character then
        local tRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local mRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot and mRoot then
            mRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.2)
            task.wait(0.04)
            local glove = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
            if glove then
                glove.Parent = LocalPlayer.Character
                task.wait(0.01)
                glove:Activate()
            end
        end
    end
end)

